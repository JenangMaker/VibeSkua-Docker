<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:views="clr-namespace:Skua.App.Avalonia.Views"
        x:Class="Skua.App.Avalonia.MainWindow"
        Title="{Binding Title}"
        Width="1000"
        Height="720"
        Icon="avares://Skua.App.Avalonia/Assets/SkuaIcon.ico">
    <!-- Skua.App.WPF's MainWindow: the main menu over the game. The game is the
         vibeskua-web Electron window, embedded over GameArea (GameEmbed.cs);
         the status line shows what Skua sees. -->
    <DockPanel>
        <DockPanel x:Name="MenuBar" DockPanel.Dock="Top" Height="28" Background="{DynamicResource SkuaPaperBrush}"
                   >
            <Button DockPanel.Dock="Right" Classes="flat" Command="{Binding ShowBotWindowCommand}" ToolTip.Tip="Bot window">
                <icons:MaterialIcon Kind="Plus" />
            </Button>
            <Button DockPanel.Dock="Right" Classes="flat" Content="Jump">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <views:JumpUserControl Width="300" DataContext="{Binding JumpViewModel}" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button DockPanel.Dock="Right" Classes="flat">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <icons:MaterialIcon Kind="ProgressCheck" IsVisible="{Binding AutoViewModel.Auto.IsRunning}" />
                    <TextBlock Text="Auto" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <views:AutoUserControl Width="400" DataContext="{Binding AutoViewModel}" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Menu DockPanel.Dock="Left" ItemsSource="{Binding MainMenuItems}">
                <Menu.Styles>
                    <Style Selector="MenuItem">
                        <Setter Property="Header" Value="{Binding Header}" />
                        <Setter Property="ItemsSource" Value="{Binding SubItems}" />
                        <Setter Property="Command" Value="{Binding Command}" />
                    </Style>
                </Menu.Styles>
            </Menu>
            <Menu DockPanel.Dock="Left">
                <MenuItem Header="Plugins" ItemsSource="{Binding Plugins}">
                    <MenuItem.Styles>
                        <Style Selector="MenuItem > MenuItem">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="Command" Value="{Binding Command}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
            </Menu>
            <Panel />
        </DockPanel>
        <Border x:Name="StatusBar" DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource SkuaBarBrush}">
            <DockPanel>
                <!-- Script sync, while it runs and for a little while after. -->
                <StackPanel x:Name="SyncPanel" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="False">
                    <icons:MaterialIcon x:Name="SyncIcon" Kind="CloudSync" Width="14" Height="14" />
                    <TextBlock x:Name="SyncText" Classes="caption" VerticalAlignment="Center" />
                    <ProgressBar x:Name="SyncProgress" Width="140" Height="6" MinHeight="6" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Classes="caption" Text="Waiting for the game page..." TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Border x:Name="GameArea" Background="#111111">
            <TextBlock x:Name="GameAreaText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Classes="caption" Text="Waiting for the game window..." />
        </Border>
    </DockPanel>
</Window>
