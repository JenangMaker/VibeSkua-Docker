<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:views="clr-namespace:Skua.App.Avalonia.Views"
        x:Class="Skua.App.Avalonia.MainWindow"
        Title="{Binding Title}"
        Width="1000"
        Height="720"
        Icon="avares://Skua.App.Avalonia/Assets/SkuaIcon.ico">
    <!-- Skua.App.WPF's MainWindow: the main menu over the game. The game is the
         vibeskua-web Electron window, embedded over GameArea (GameEmbed.cs);
         the status line shows what Skua sees. The 2.x title bar is added in
         code, except in a tab (the tab host has it). -->
    <DockPanel x:Name="RootDock">
        <!-- 2.x top bar (upstream 2.1.2's TopNavBorder): menus with icons, then Auto and
             Jump as toggles that open popup panels, and the bot window button. -->
        <Border x:Name="MenuBar" DockPanel.Dock="Top" Height="34" Padding="4,0"
                Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="0,0,4,0" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center">
                <ToggleButton x:Name="AutoToggle" Classes="top-nav-item"
                              ToolTip.Tip="Automated Combat &amp; Hunting Controls">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="RobotOutline" Width="13" Height="13" VerticalAlignment="Center"
                                            Foreground="{DynamicResource SkuaTextBrush}" />
                        <TextBlock Text="Auto" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        <Border Width="6" Height="6" CornerRadius="3" Margin="2,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource SkuaSuccessBrush}"
                                IsVisible="{Binding AutoViewModel.Auto.IsRunning}" />
                    </StackPanel>
                </ToggleButton>
                <Popup Placement="Bottom" IsLightDismissEnabled="True"
                       IsOpen="{Binding IsChecked, ElementName=AutoToggle, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=AutoToggle}">
                    <Border Classes="topbar-popup" Background="{DynamicResource SkuaSurfaceBrush}"
                            BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <views:AutoUserControl Width="360" DataContext="{Binding AutoViewModel}" />
                    </Border>
                </Popup>

                <ToggleButton x:Name="JumpToggle" Classes="top-nav-item"
                              ToolTip.Tip="Map &amp; Cell Fast Jump Controls">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="RunFast" Width="13" Height="13" VerticalAlignment="Center"
                                            Foreground="{DynamicResource SkuaTextBrush}" />
                        <TextBlock Text="Jump" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Popup Placement="Bottom" IsLightDismissEnabled="True"
                       IsOpen="{Binding IsChecked, ElementName=JumpToggle, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=JumpToggle}">
                    <Border Classes="topbar-popup" Background="{DynamicResource SkuaSurfaceBrush}"
                            BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <views:JumpUserControl Width="320" DataContext="{Binding JumpViewModel}" />
                    </Border>
                </Popup>

                <Border Width="1" Height="16" Margin="2,0" VerticalAlignment="Center"
                        Background="{DynamicResource SkuaBorderBrush}" />

                <Button Classes="top-nav-item" Width="28" Height="28" Padding="0"
                        Command="{Binding ShowBotWindowCommand}" ToolTip.Tip="Show All Bot Windows &amp; Tools">
                    <icons:MaterialIcon Kind="Plus" Width="15" Height="15" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Foreground="{DynamicResource SkuaTextBrush}" />
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Styles>
                    <!-- Top-level entries: icon and name; sub-entries: the icon in the menu's icon column. -->
                    <Style Selector="Menu > MenuItem">
                        <Setter Property="HeaderTemplate">
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <icons:MaterialIcon Kind="{Binding Converter={StaticResource MenuIcon}}"
                                                        IsVisible="{Binding Converter={StaticResource MenuIcon}, ConverterParameter=has}"
                                                        Width="14" Height="14" VerticalAlignment="Center"
                                                        Foreground="{DynamicResource SkuaTextBrush}" />
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="MenuItem MenuItem">
                        <Setter Property="Icon">
                            <Template>
                                <icons:MaterialIcon Kind="{Binding Header, Converter={StaticResource MenuIcon}}"
                                                    IsVisible="{Binding Header, Converter={StaticResource MenuIcon}, ConverterParameter=has}"
                                                    Width="14" Height="14" />
                            </Template>
                        </Setter>
                    </Style>
                </StackPanel.Styles>
                <Menu Classes="top-toolbar" ItemsSource="{Binding MainMenuItems}">
                    <Menu.Styles>
                        <Style Selector="MenuItem">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="ItemsSource" Value="{Binding SubItems}" />
                            <Setter Property="Command" Value="{Binding Command}" />
                        </Style>
                    </Menu.Styles>
                </Menu>
                <Menu Classes="top-toolbar">
                    <MenuItem Header="Plugins" ItemsSource="{Binding Plugins}">
                        <MenuItem.Styles>
                            <Style Selector="MenuItem > MenuItem">
                                <Setter Property="Header" Value="{Binding Header}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                            </Style>
                        </MenuItem.Styles>
                    </MenuItem>
                </Menu>
            </StackPanel>
        </DockPanel>
        </Border>
        <Border x:Name="StatusBar" DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource SkuaBarBrush}">
            <DockPanel>
                <!-- Script sync, while it runs and for a little while after. -->
                <StackPanel x:Name="SyncPanel" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="False">
                    <icons:MaterialIcon x:Name="SyncIcon" Kind="CloudSync" Width="14" Height="14" />
                    <TextBlock x:Name="SyncText" Classes="caption" VerticalAlignment="Center" />
                    <ProgressBar x:Name="SyncProgress" Width="140" Height="6" MinHeight="6" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Classes="caption" Text="Waiting for the game page..." TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <DockPanel x:Name="GameRow">
            <!-- GameContainerUserControl's dashboard: shown in the room the game
                 does not need when the window is wider than the game (and not
                 in Grid View). -->
            <Border x:Name="Dashboard" DockPanel.Dock="Right" Width="170" Padding="14,16" IsVisible="False"
                    Background="{DynamicResource SkuaSurfaceAltBrush}" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1,0,0,0">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <StackPanel.Styles>
                        <Style Selector="TextBlock.label">
                            <Setter Property="Foreground" Value="Gray" />
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                        <Style Selector="TextBlock.value">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </StackPanel.Styles>
                    <TextBlock Text="BOT DASHBOARD" Foreground="#D080FF" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Classes="label" Text="Kills" />
                    <TextBlock Classes="value" Text="{Binding ScriptStats.Kills}" />
                    <TextBlock Classes="label" Text="Drops picked" />
                    <TextBlock Classes="value" Text="{Binding ScriptStats.Drops}" />
                    <TextBlock Classes="label" Text="Quests completed" />
                    <TextBlock Classes="value" Text="{Binding ScriptStats.QuestsCompleted}" />
                    <TextBlock Classes="label" Text="Deaths" />
                    <TextBlock Classes="value" Text="{Binding ScriptStats.Deaths}" />
                    <TextBlock Classes="label" Text="Relogins" />
                    <TextBlock Classes="value" Text="{Binding ScriptStats.Relogins}" />
                    <TextBlock Classes="label" Text="Time" />
                    <TextBlock Classes="value" Text="{Binding ScriptStats.Time, StringFormat='{}{0:hh\\:mm\\:ss}'}" />
                </StackPanel>
            </Border>
            <Border x:Name="GameArea" Background="#111111">
                <Panel>
                    <TextBlock x:Name="GameAreaText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Classes="caption" Text="Waiting for the game window..." />
                    <!-- Under the (1x1) game while Headless Mode is on. -->
                    <StackPanel x:Name="HeadlessOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="8" IsVisible="False">
                        <TextBlock Text="Headless Mode Active" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="The game still runs, at 1 frame per second and not drawn, to save CPU."
                                   Foreground="Gray" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Text="Turn Headless Mode off (Army Control > Misc Options, or its hotkey) to see it again."
                                   Foreground="Gray" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Panel>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
