<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theming="clr-namespace:Skua.App.Avalonia.Theming"
        x:Class="Skua.App.Avalonia.HostWindow"
        Title="{Binding Title}"
        Icon="avares://Skua.App.Avalonia/Assets/SkuaIcon.ico">
    <DockPanel>
        <theming:WindowTitleBar DockPanel.Dock="Top" />
        <ContentControl Content="{Binding}" />
    </DockPanel>
</Window>
