<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Name="Root"
             x:Class="Skua.App.Avalonia.Theming.WindowTitleBar">
  <!-- From upstream VibeSkua 2.1.2 (Skua.Shared.Avalonia/Controls/Shell/WindowTitleBar.axaml),
       without its background artwork and accent-background options. -->
  <Grid Height="32" Background="{DynamicResource SkuaSurfaceAltBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Width="30" Height="30" Margin="6,0" HorizontalAlignment="Center">
      <Border Width="30" Height="30" Classes="titlebar-app-badge" CornerRadius="15" />
      <Image x:Name="IconImage" Width="30" Height="30" Stretch="Uniform"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

    <TextBlock x:Name="TitleTextBlock" Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center"
               Text="{Binding TitleText, ElementName=Root}" TextTrimming="CharacterEllipsis"
               Foreground="{DynamicResource SkuaAccentBrush}" Classes="titlebar-title" />

    <!-- Ours: room for a window's own controls (the tab host puts its tab strip here). -->
    <ContentPresenter Grid.Column="2" Content="{Binding Extra, ElementName=Root}" VerticalAlignment="Stretch" />

    <StackPanel Grid.Column="3" Height="28" VerticalAlignment="Top" Orientation="Horizontal">
      <Button x:Name="MinimizeButton" Classes="titlebar" ToolTip.Tip="Minimize"
              Foreground="{DynamicResource SkuaAccentBrush}">
        <icons:MaterialIcon Kind="WindowMinimize" Width="12" Height="12" />
      </Button>
      <Button x:Name="MaximizeButton" Classes="titlebar" ToolTip.Tip="Maximize"
              Foreground="{DynamicResource SkuaAccentBrush}">
        <icons:MaterialIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="12" Height="12" />
      </Button>
      <Button x:Name="CloseButton" Classes="titlebar titlebar-close" ToolTip.Tip="Close"
              Foreground="{DynamicResource SkuaAccentBrush}">
        <icons:MaterialIcon Kind="WindowClose" Width="12" Height="12" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
