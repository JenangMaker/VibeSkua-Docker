<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <!-- 6px after the label so the keyboard focus ring, drawn on the control's own edge, doesn't cover it -->
    <Style Selector="CheckBox, RadioButton">
        <Setter Property="Padding" Value="8,0,6,0" />
    </Style>
    
    <Style Selector="CheckBox.icon">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox.icon:checked">
        <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>

    <Style Selector="CheckBox.compare">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="≤"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox.compare:checked">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="≥"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox.value-type">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="#"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox.value-type:checked">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="%"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Fluent check box, radio and switch at the proposed sizes: 18px box and circle, 12px switch knob.
         Their colours come from the Fluent resource keys overridden in Colors.axaml. The template sets these
         sizes itself, which beats a plain style; the always-true :not(:skua-never) makes these trigger styles,
         which win. -->
    <Style Selector="CheckBox:not(:skua-never) /template/ Border#NormalRectangle">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="RadioButton:not(:skua-never) /template/ Ellipse#OuterEllipse, RadioButton:not(:skua-never) /template/ Ellipse#CheckOuterEllipse">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="RadioButton:not(:skua-never) /template/ Ellipse#CheckGlyph">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
    </Style>
    <Style Selector="ToggleSwitch:not(:skua-never) /template/ :is(Layoutable)#SwitchKnobOn, ToggleSwitch:not(:skua-never) /template/ :is(Layoutable)#SwitchKnobOff">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="ToggleSwitch:not(:skua-never) /template/ Border#OuterBorder">
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
</Styles>



