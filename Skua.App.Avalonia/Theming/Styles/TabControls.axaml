<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Global TabControl and TabItem defaults (tab strips with their own styles, like the client's
         instance tabs and the Cosmetics tabs, override these) -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6,6,0,0" />
    </Style>

    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    </Style>

    <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
    </Style>

    <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>

    <!-- Section tabs: the tabs sit in a segmented track (equal-width segments) above the content.
         Used by TabControl.section-tabs and the Accounts / Groups switcher. -->
    <Style Selector="TabControl.section-tabs, TabControl.account-groups-switcher">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="TabControl">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SkuaSurfaceAltBrush}"
                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3"
                            Margin="0,0,0,8">
                        <ItemsPresenter x:Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TabControl.section-tabs TabItem, TabControl.account-groups-switcher TabItem">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TabItem">
                <Border x:Name="SectionTabRoot"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="1,0"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="SectionTabHeader"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.section-tabs TabItem:pointerover /template/ Border#SectionTabRoot, TabControl.account-groups-switcher TabItem:pointerover /template/ Border#SectionTabRoot">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
    </Style>
    <Style Selector="TabControl.section-tabs TabItem:pointerover, TabControl.account-groups-switcher TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="TabControl.section-tabs TabItem:selected /template/ Border#SectionTabRoot, TabControl.account-groups-switcher TabItem:selected /template/ Border#SectionTabRoot">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>
    <Style Selector="TabControl.section-tabs TabItem:selected, TabControl.account-groups-switcher TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</Styles>
