<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    
    <Style Selector="ComboBox.header-gap">
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    
    <Style Selector="ComboBox.gap-left-8">
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style Selector="ComboBox.gap-right-8">
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Sleek Custom ControlTemplate for ComboBox following Pure Neutral Dark UI -->
    <Style Selector="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="PART_RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid ColumnDefinitions="*,Auto" Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="PART_PlaceholderTextBlock"
                                       Grid.Column="0"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                                       VerticalAlignment="Center"
                                       IsVisible="{TemplateBinding SelectedItem, Converter={x:Static ObjectConverters.IsNull}}" />

                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{DynamicResource SkuaTextBrush}"
                                              IsVisible="{TemplateBinding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <!-- Chevron, like the other Material icons in the app -->
                            <materialIcons:MaterialIcon Grid.Column="1"
                                      Kind="ChevronDown"
                                      Width="16"
                                      Height="16"
                                      Margin="6,0,-2,0"
                                      Foreground="{DynamicResource SkuaMutedTextBrush}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Popup Dropdown Menu -->
                    <Popup x:Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=PART_RootBorder}"
                           Placement="Bottom"
                           IsLightDismissEnabled="True"
                           MinWidth="{Binding Bounds.Width, ElementName=PART_RootBorder}"
                           MaxHeight="280">
                        <Border Background="{DynamicResource SkuaSurfaceBrush}"
                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                Margin="0,4,0,0"
                                BoxShadow="0 8 24 #30000000">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderStrongBrush}" />
    </Style>

    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="ComboBox:focus, ComboBox:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
    </Style>

    <!-- ComboBox Items Styling -->
    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="ComboBox.columns-picker">
        <Setter Property="Width" Value="64" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

</Styles>
