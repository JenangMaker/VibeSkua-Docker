<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Our 1.x class names (from Skua.WPF's MaterialDesign styles) on top of the 2.x styles in
         Theming/BaseTheme.axaml, so views not yet redone match the new look. Windows, buttons,
         list boxes and menus are styled there. -->

    <!-- MaterialDesignFlatButton / MaterialDesignToolButton: no fill or border at rest -->
    <Style Selector="Button.flat, ToggleButton.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="ToggleButton.flat:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SkuaAccentTintBrush}" />
    </Style>

    <!-- MaterialDesignOutlinedButton: 2.x's outline (secondary) button -->
    <Style Selector="Button.outlined">
        <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
    </Style>

    <Style Selector="ListBox.plain">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- MaterialDesign headline text -->
    <Style Selector="TextBlock.h6">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
    </Style>

    <!-- MaterialDesignCardGroupBox, as a 2.x section panel: small caps title over a surface card -->
    <Style Selector="HeaderedContentControl.card">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource SkuaSurfaceBrush}" BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="10,8,10,4">
                            <ContentPresenter Content="{TemplateBinding Header}" TextElement.FontWeight="SemiBold"
                                              TextElement.FontSize="11" TextElement.Foreground="{DynamicResource SkuaMutedTextBrush}" />
                        </Border>
                        <ContentPresenter Content="{TemplateBinding Content}" Margin="6,0,6,6" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Popups (menus, drop-downs, tooltips, the Auto and Jump cards) are rounded over a transparent
         window. Without a compositor (the Docker desktop: KasmVNC's X server) a window cannot be
         transparent and Avalonia fills it with this brush, white by default: the corners showed
         white. With the menu surface they blend in. No effect where transparency works (Windows). -->
    <Style Selector="PopupRoot">
        <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource SkuaSurfaceBrush}" />
    </Style>
</Styles>
