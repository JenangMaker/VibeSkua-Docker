<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.SkillRuleEditorDialog">
    <!-- 2.x dialog: the use-rule rows, then Cancel / Confirm on the right. -->
    <StackPanel Spacing="10">
        <v:SkillRuleUserControl DataContext="{Binding UseRules}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Classes="skua-button w84" HorizontalContentAlignment="Center" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            <Button Classes="skua-button skua-primary w84" HorizontalContentAlignment="Center" Content="Confirm" IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
