<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.CBOOtherOptionsUserControl">
    <!-- 2.x layout (upstream 2.1.2 CBOOtherOptionsView): one list, a tinted header per
         category, a row per option. -->
    <Border Classes="option-list" VerticalAlignment="Top" Margin="0,6,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Options}" Margin="0,0,0,-1">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border Classes="option-section">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:MaterialIcon Kind="TuneVerticalVariant" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" />
                                    <TextBlock Classes="section-label" Text="{Binding Category}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="option-row">
                                            <v:CBOOptionItemUserControl />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
