<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.LoaderView">
    <!-- 2.x layout (upstream 2.1.2 LoaderView): Shop / Quests switch with the IDs and Load, the
         quest cache as a list with its count and search, the cache update bar, then the
         selection actions. -->
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Border Padding="3" CornerRadius="8" Background="{DynamicResource SkuaSurfaceBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
                <ListBox Classes="chips" SelectedIndex="{Binding SelectedIndex}">
                    <ListBoxItem Content="Shop" ToolTip.Tip="Load the specified shop." />
                    <ListBoxItem Content="Quests" ToolTip.Tip="Load the specified quests." />
                </ListBox>
            </Border>
            <TextBox Grid.Column="1" Watermark="IDs, e.g. 2566 or 101, 102" Text="{Binding InputIDs}"
                     ToolTip.Tip="Loads a shop/quest with the specified ID. Multiple quests can be loaded by separating them with commas or spaces.">
                <TextBox.InnerLeftContent>
                    <icons:MaterialIcon Kind="Pound" Width="15" Height="15" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="2" Classes="skua-button skua-primary w84" Command="{Binding LoadCommand}"
                    ToolTip.Tip="Loads a shop/quest with the specified ID.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="Download" Width="15" Height="15" />
                    <TextBlock Text="Load" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,240" ColumnSpacing="6">
            <TextBlock Classes="section-label" Text="QUEST CACHE" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="count">
                <TextBlock Text="{Binding QuestIDs.Count}" />
            </Border>
            <TextBox x:Name="SearchBox" Grid.Column="3" Watermark="Search by name" IsEnabled="{Binding !IsLoading}">
                <TextBox.InnerLeftContent>
                    <icons:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </Grid>

        <Panel Grid.Row="2">
            <Border Classes="option-list">
                <ListBox x:Name="QuestIDsListBox" SelectionMode="Multiple" IsEnabled="{Binding !IsLoading}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding ID}" FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Padding="12,6" CornerRadius="8"
                    Background="{DynamicResource SkuaSurfaceAltBrush}" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1"
                    BoxShadow="0 2 8 0 #80000000" IsVisible="{Binding IsLoading}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock VerticalAlignment="Center" Text="{Binding ProgressReport}" />
                    <Button Classes="icon danger-icon" Width="26" Height="26" Command="{Binding CancelQuestLoadCommand}" ToolTip.Tip="Cancel">
                        <icons:MaterialIcon Kind="Close" Width="15" Height="15" />
                    </Button>
                </StackPanel>
            </Border>
        </Panel>

        <Border Grid.Row="3" Padding="10,6" CornerRadius="8" Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1" IsEnabled="{Binding !IsLoading}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Text="Update cache" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                <Button Grid.Column="1" Classes="skua-button small" Command="{Binding UpdateQuestsCommand}" CommandParameter="{StaticResource FalseValue}"
                        ToolTip.Tip="Keep the cached quests and add the new ones.">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <icons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                        <TextBlock Text="Add missing" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="skua-button small" Command="{Binding UpdateQuestsCommand}" CommandParameter="{StaticResource TrueValue}"
                        Content="Rebuild all" ToolTip.Tip="Replace every quest in the cache." />
                <Border Grid.Column="3" Width="1" Margin="2,4" Background="{DynamicResource SkuaBorderBrush}" />
                <TextBox Grid.Column="4" Watermark="Range, e.g. 2566, 2599" Text="{Binding QuestRange}"
                         ToolTip.Tip="Quest ID range as: startID, endID" />
                <Button Grid.Column="5" Classes="skua-button small" Command="{Binding UpdateQuestsRangeCommand}" Content="Update range"
                        ToolTip.Tip="Update the quests in this ID range" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsEnabled="{Binding !IsLoading}">
            <TextBlock x:Name="SelectedText" Text="None selected" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <Button Grid.Column="1" Classes="skua-button" ToolTip.Tip="Copy the selected quests">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="ContentCopy" Width="15" Height="15" />
                    <TextBlock Text="Copy" VerticalAlignment="Center" />
                    <icons:MaterialIcon Kind="ChevronDown" Width="15" Height="15" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                        <MenuItem Header="IDs (Ctrl+C)" Click="CopyIds_Click" />
                        <MenuItem Header="Names (Ctrl+Shift+C)" Click="CopyNames_Click" />
                        <MenuItem Header="Name | ID" Click="CopyNamesAndIds_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="FakeComplete" Grid.Column="2" Classes="skua-button" Click="FakeComplete_Click" IsEnabled="False"
                    ToolTip.Tip="Sends the quest complete packet to the client (one quest selected).">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="CheckAll" Width="15" Height="15" />
                    <TextBlock Text="Fake complete" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="LoadSelected" Grid.Column="3" Classes="skua-button skua-primary" Click="LoadQuests_Click" IsEnabled="False"
                    ToolTip.Tip="(Ctrl + L) Load all the selected quests.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="Download" Width="15" Height="15" />
                    <TextBlock Text="Load selected" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
