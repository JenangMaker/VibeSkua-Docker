<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.InputDialog">
    <!-- 2.x dialog: hint, the input(s), then Cancel / Confirm on the right. The floating watermark stays: the hint is the only label. -->
    <StackPanel Spacing="10">
        <TextBlock FontSize="12" Foreground="{DynamicResource SkuaMutedTextBrush}" Text="{Binding DialogHint}" TextWrapping="Wrap"
                   IsVisible="{Binding DialogHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBox Watermark="{Binding TextBoxHint}" UseFloatingWatermark="True"
                 Text="{Binding DialogTextInput}" IsVisible="{Binding NumberOnly}" b:Behave.OnlyNumbers="True" />
        <TextBox Watermark="{Binding TextBoxHint}" UseFloatingWatermark="True"
                 Text="{Binding DialogTextInput}" IsVisible="{Binding !NumberOnly}" />
        <TextBox Watermark="{Binding SecondTextBoxHint}" UseFloatingWatermark="True"
                 Text="{Binding SecondTextInput}" IsVisible="{Binding ShowSecondInput}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Classes="skua-button w84" HorizontalContentAlignment="Center" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            <Button Classes="skua-button skua-primary w84" HorizontalContentAlignment="Center" Content="Confirm" IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
