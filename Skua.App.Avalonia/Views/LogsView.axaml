<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.LogsView">
    <DockPanel Margin="6">
        <ListBox DockPanel.Dock="Top" Classes="plain" Margin="0,0,0,6"
                 ItemsSource="{Binding LogTabs}" SelectedItem="{Binding SelectedTab}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
                <!-- MaterialDesignChoiceChipPrimaryOutlineListBox -->
                <Style Selector="ListBoxItem">
                    <Setter Property="BorderBrush" Value="{DynamicResource SkuaPrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="14" />
                    <Setter Property="Padding" Value="12,4" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Width="60" TextAlignment="Center" FontWeight="Medium" Text="{Binding Title}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ContentControl Content="{Binding SelectedTab}" />
    </DockPanel>
</UserControl>
