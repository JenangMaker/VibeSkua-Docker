<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.ScriptSchedulerUserControl">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Text="Script Playlist Queue" FontSize="20" FontWeight="Bold" Margin="10" />
        <TextBlock Grid.Row="1" Margin="10,0,10,5" FontWeight="SemiBold" Foreground="{DynamicResource SkuaPrimaryBrush}"
                   Text="{Binding ScriptQueue.Count, StringFormat='Total Queued: {0}'}" />
        <ListBox x:Name="Queue" Grid.Row="2" Margin="10,0,10,10" ItemsSource="{Binding ScriptQueue}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource SkuaDividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                        <Grid Margin="5" ColumnDefinitions="3*,*,*,Auto,Auto">
                            <TextBox Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"
                                     TextWrapping="Wrap" Background="Transparent" BorderThickness="0" ToolTip.Tip="Rename this script instance" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource SkuaPrimaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Center" Margin="10,0" />
                            <Button Grid.Column="3" Classes="flat" Margin="10,0,0,0" ToolTip.Tip="Edit Script Options"
                                    Command="{Binding $parent[ListBox].DataContext.EditScriptConfigCommand}" CommandParameter="{Binding}">
                                <icons:MaterialIcon Kind="Cog" />
                            </Button>
                            <Button Grid.Column="4" Classes="flat" Margin="10,0,0,0" Foreground="#e57373" ToolTip.Tip="Remove from queue"
                                    Command="{Binding $parent[ListBox].DataContext.RemoveScriptCommand}" CommandParameter="{Binding}">
                                <icons:MaterialIcon Kind="Close" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10" Spacing="10">
            <Button Classes="flat" Content="Load Playlist" Command="{Binding LoadPlaylistCommand}" />
            <Button Classes="flat" Content="Save Playlist" Command="{Binding SavePlaylistCommand}" />
            <Button Content="Search Scripts" Command="{Binding OpenScriptRepoCommand}" />
            <Button Classes="accent" Content="Start Queue" Command="{Binding StartQueueCommand}" />
            <Button Content="Stop Queue" Command="{Binding StopQueueCommand}" Background="{DynamicResource SkuaSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
