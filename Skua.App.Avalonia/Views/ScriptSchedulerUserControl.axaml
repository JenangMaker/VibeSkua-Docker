<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.ScriptSchedulerUserControl">
    <!-- 2.x layout (upstream 2.1.2 ScriptSchedulerView): Start / Stop queue and the count, Load /
         Save / Add scripts, then the playlist as a table (script, status, time, options, remove). -->
    <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <Panel>
                <Button Classes="skua-button skua-primary w140" Command="{Binding StartQueueCommand}" IsVisible="{Binding !IsRunningQueue}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="PlayCircleOutline" Width="16" Height="16" />
                        <TextBlock Text="Start queue" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="skua-button skua-danger w140" Command="{Binding StopQueueCommand}" IsVisible="{Binding IsRunningQueue}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="StopCircleOutline" Width="16" Height="16" />
                        <TextBlock Text="Stop queue" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Panel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}"
                       Text="{Binding ScriptQueue.Count, StringFormat='{}{0} scripts'}" />
            <Button Grid.Column="3" Classes="skua-button" Command="{Binding LoadPlaylistCommand}" ToolTip.Tip="Load a saved playlist">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                    <TextBlock Text="Load" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="skua-button" Command="{Binding SavePlaylistCommand}" ToolTip.Tip="Save this playlist">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="ContentSave" Width="15" Height="15" />
                    <TextBlock Text="Save" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="5" Classes="skua-button" Command="{Binding OpenScriptRepoCommand}" ToolTip.Tip="Open Search Scripts to queue scripts">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="Plus" Width="16" Height="16" />
                    <TextBlock Text="Add scripts" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Classes="option-list">
            <Grid RowDefinitions="Auto,*">
                <Border Classes="option-section">
                    <Grid ColumnDefinitions="*,120,90,64" ColumnSpacing="8">
                        <TextBlock Classes="section-label" Text="SCRIPT" />
                        <TextBlock Grid.Column="1" Classes="section-label" Text="STATUS" />
                        <TextBlock Grid.Column="2" Classes="section-label" Text="TIME" />
                    </Grid>
                </Border>
                <ListBox x:Name="Queue" Grid.Row="1" ItemsSource="{Binding ScriptQueue}" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12,4" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,120,90,64" ColumnSpacing="8">
                                <TextBox Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" Padding="0"
                                         Background="Transparent" BorderThickness="0" MinHeight="0" ToolTip.Tip="Rename this script instance" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource SkuaAccentBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Center" FontSize="11"
                                           FontFamily="{DynamicResource MonoFont}" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <Button Classes="icon icon-muted" Width="26" Height="26" ToolTip.Tip="Edit Script Options"
                                            Command="{Binding $parent[ListBox].DataContext.EditScriptConfigCommand}" CommandParameter="{Binding}">
                                        <icons:MaterialIcon Kind="CogOutline" Width="15" Height="15" />
                                    </Button>
                                    <Button Classes="icon danger-icon" Width="26" Height="26" ToolTip.Tip="Remove from the queue"
                                            Command="{Binding $parent[ListBox].DataContext.RemoveScriptCommand}" CommandParameter="{Binding}">
                                        <icons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}"
                           Text="The playlist is empty. Add scripts to queue them."
                           IsVisible="{Binding !ScriptQueue.Count}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" Text="Click a name to rename it" />
    </Grid>
</UserControl>
