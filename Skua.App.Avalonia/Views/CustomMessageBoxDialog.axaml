<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.CustomMessageBoxDialog">
    <!-- 2.x dialog: the message, then the script's own buttons on the right. -->
    <StackPanel Spacing="12">
        <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="20" />
        <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Classes="skua-button" Margin="8,0,0,8" MinWidth="84" HorizontalContentAlignment="Center"
                            Click="Button_Click" Content="{Binding}" ToolTip.Tip="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
