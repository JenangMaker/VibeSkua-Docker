<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.MessageBoxDialog">
    <!-- 2.x dialog: the message, then OK or No / Yes on the right, Yes as the primary button. -->
    <StackPanel Spacing="12">
        <ScrollViewer MaxHeight="700" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="20" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="skua-button skua-primary w84" HorizontalContentAlignment="Center" Content="OK" IsDefault="True" IsCancel="True"
                    Click="No_Click" IsVisible="{Binding !YesAndNo}" />
            <Button Classes="skua-button w84" HorizontalContentAlignment="Center" Content="No" IsCancel="True" Click="No_Click" IsVisible="{Binding YesAndNo}" />
            <Button Classes="skua-button skua-primary w84" HorizontalContentAlignment="Center" Content="Yes" IsDefault="True" Click="Yes_Click" IsVisible="{Binding YesAndNo}" />
        </StackPanel>
    </StackPanel>
</UserControl>
