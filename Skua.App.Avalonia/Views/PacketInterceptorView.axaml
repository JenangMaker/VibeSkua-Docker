<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.PacketInterceptorView">
    <!-- 2.x layout (upstream 2.1.2 PacketInterceptorView): server, Connect and Log packets;
         search with the packet types in a Show menu; the packets (tinted by direction); then the
         count, the colour key and Copy / Clear. -->
    <UserControl.Styles>
        <Style Selector="Border.key">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="200,Auto,Auto,Auto,*" ColumnSpacing="8">
            <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Server" ItemsSource="{Binding ServerList}" SelectedItem="{Binding SelectedServer}" />
            <Button Grid.Column="1" Classes="skua-button w140" Command="{Binding ConnectInterceptorCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="LinkVariant" Width="15" Height="15" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Running, Converter={StaticResource BoolText}, ConverterParameter='Disconnect|Connect'}" />
                </StackPanel>
            </Button>
            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" IsChecked="{Binding IsLogging}" />
            <TextBlock Grid.Column="3" Text="Log packets" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="SearchBox" Watermark="Search packets">
                <TextBox.InnerLeftContent>
                    <icons:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="1" Classes="skua-button" ToolTip.Tip="Packet types to show">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="FilterVariant" Width="16" Height="16" />
                    <TextBlock Text="Show" VerticalAlignment="Center" />
                    <Border Classes="count"><TextBlock x:Name="ShowCount" Text="0 / 0" /></Border>
                    <icons:MaterialIcon Kind="ChevronDown" Width="15" Height="15" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <Grid Width="260" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <TextBox x:Name="FilterSearchBox" Watermark="Search filters" />
                            <ScrollViewer Grid.Row="1" MaxHeight="320" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="FiltersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Stretch" Margin="0,1" Content="{Binding Content}" IsChecked="{Binding IsChecked}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Row="2" Classes="skua-button small" HorizontalAlignment="Right" Command="{Binding ClearFiltersCommand}" Content="Clear filters" />
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <Border Grid.Row="2" Classes="option-list">
            <ListBox x:Name="PacketsList" SelectionMode="Multiple" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     b:Behave.CopySelected="True" b:Behave.ScrollToEnd="True" b:Behave.UnselectAllMenu="True">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,3" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Background" Value="{Binding Outbound, Converter={StaticResource PacketDirectionBrush}}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" FontFamily="{DynamicResource MonoFont}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}"
                       Text="{Binding Packets.Count, StringFormat='{}{0} packets'}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                <Border Classes="key" Background="#66FFFF00" />
                <TextBlock Text="Outbound" FontSize="11" Margin="0,0,8,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                <Border Classes="key" Background="#660000FF" />
                <TextBlock Text="Inbound" FontSize="11" Margin="0,0,8,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                <Border Classes="key" Background="#66FF0000" />
                <TextBlock Text="Blocked" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            </StackPanel>
            <Button Classes="skua-button" Grid.Column="2" Click="Copy_Click" ToolTip.Tip="Copy the selected packets">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="ContentCopy" Width="15" Height="15" />
                    <TextBlock Text="Copy" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="skua-button skua-danger-soft" Grid.Column="3" Command="{Binding ClearPacketsCommand}" ToolTip.Tip="Clear the packets">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" />
                    <TextBlock Text="Clear" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
