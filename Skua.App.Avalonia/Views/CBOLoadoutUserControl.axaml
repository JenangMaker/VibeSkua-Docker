<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.CBOLoadoutUserControl">
    <!-- 2.x layout (upstream 2.1.2 CBOLoadoutView): class cards, then the equipment slots in a
         collapsed card. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="2,6,2,2">
            <v:CBOClassSelectUserControl DataContext="{Binding ClassSelectViewModel}" />
            <Expander IsExpanded="False" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8"
                      Background="{DynamicResource SkuaSurfaceBrush}" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="ShieldCrownOutline" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" />
                        <TextBlock Text="Detailed Equipment Slots" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="(Optional per-mode gear overrides)" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    </StackPanel>
                </Expander.Header>
                <Border Padding="10,8,10,10">
                    <v:CBOClassEquipmentUserControl DataContext="{Binding ClassEquipmentViewModel}" />
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
