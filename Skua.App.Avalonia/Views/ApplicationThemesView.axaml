<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.ApplicationThemesView">
    <!-- 2.x layout (upstream 2.1.2 ApplicationThemesView): top tabs for the palette, the theme
         library and the backgrounds, each page as a card. Our theme model is simpler than
         upstream's (four colour targets, no calibration), so the palette page keeps ours. -->
    <UserControl.Styles>
        <Style Selector="Border.page">
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="RadioButton.target">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="10">
        <Border Padding="4" CornerRadius="10" Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
            <ListBox x:Name="Tabs" Classes="chips" SelectedIndex="0">
                <ListBoxItem Content="Palette &amp; Accents" />
                <ListBoxItem Content="Theme Library" />
                <ListBoxItem Content="Custom Backgrounds" />
            </ListBox>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Panel>
                <!-- Palette -->
                <Border x:Name="PalettePage" Classes="page">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="ThemeName" Watermark="Theme name" />
                            <Button Grid.Column="1" Classes="skua-button skua-primary" Click="SaveTheme_Click" ToolTip.Tip="Save the current colours as a theme">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:MaterialIcon Kind="ContentSave" Width="15" Height="15" />
                                    <TextBlock Text="Save preset" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Dark mode" VerticalAlignment="Center" />
                            <ToggleSwitch OnContent="" OffContent="" MinWidth="0" IsChecked="{Binding ThemeService.IsDarkTheme}" />
                        </StackPanel>
                        <Border Grid.Row="2" Height="1" Background="{DynamicResource SkuaBorderBrush}" />
                        <Grid Grid.Row="3" ColumnDefinitions="170,*" ColumnSpacing="14">
                            <StackPanel>
                                <TextBlock Classes="section-label" Text="ACTIVE COLOUR TARGET" Margin="0,0,0,8" />
                                <RadioButton Classes="target" GroupName="scheme" Content="Primary accent" IsChecked="True" Tag="Primary" Click="Scheme_Click" />
                                <RadioButton Classes="target" GroupName="scheme" Content="Secondary" Tag="Secondary" Click="Scheme_Click" />
                                <RadioButton Classes="target" GroupName="scheme" Content="Text on accent" Tag="PrimaryForeground" Click="Scheme_Click" />
                                <RadioButton Classes="target" GroupName="scheme" Content="Text on secondary" Tag="SecondaryForeground" Click="Scheme_Click" />
                            </StackPanel>
                            <ColorView x:Name="Picker" Grid.Column="1" IsAlphaEnabled="False" IsAccentColorsVisible="False"
                                       ColorChanged="Picker_ColorChanged" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Library -->
                <Border x:Name="LibraryPage" Classes="page" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-label" Text="BUILT-IN" />
                        <ItemsControl ItemsSource="{Binding ThemeService.Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,8,8" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8"
                                            Background="{Binding PrimaryBrush}" Foreground="{Binding PrimaryForegroundBrush}" FontWeight="SemiBold"
                                            Content="{Binding Name}" ToolTip.Tip="Use this theme"
                                            Command="{Binding $parent[v:ApplicationThemesView].DataContext.SetCurrentThemeCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="section-label" Text="SAVED" />
                        <ItemsControl ItemsSource="{Binding ThemeService.UserThemes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,8" ColumnDefinitions="*,Auto">
                                        <Button Grid.ColumnSpan="2" Height="40" Padding="12,0,40,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8"
                                                Background="{Binding PrimaryBrush}" Foreground="{Binding PrimaryForegroundBrush}" FontWeight="SemiBold"
                                                Content="{Binding Name}" ToolTip.Tip="Use this theme"
                                                Command="{Binding $parent[v:ApplicationThemesView].DataContext.SetCurrentThemeCommand}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="1" Classes="icon danger-icon" Width="26" Height="26" Margin="0,0,6,0" ToolTip.Tip="Delete this theme"
                                                Command="{Binding $parent[v:ApplicationThemesView].DataContext.RemoveThemeCommand}" CommandParameter="{Binding}">
                                            <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}"
                                   Text="Save a preset on the Palette tab to add it here." IsVisible="{Binding !ThemeService.UserThemes.Count}" />
                    </StackPanel>
                </Border>

                <!-- Backgrounds -->
                <Border x:Name="BackgroundsPage" Classes="page" IsVisible="False">
                    <Grid DataContext="{Binding BackgroundTheme}" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                        <TextBlock Classes="section-label" Text="GAME BACKGROUND" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Select background"
                                      ItemsSource="{Binding AvailableBackgrounds}" SelectedItem="{Binding SelectedBackground}" />
                            <Button Grid.Column="1" Classes="skua-button" Command="{Binding BrowseBackgroundCommand}" ToolTip.Tip="Browse for a local SWF file">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                    <TextBlock Text="Browse" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Classes="skua-button" Width="34" Padding="0" Command="{Binding RefreshBackgroundsCommand}" ToolTip.Tip="Reload the background list">
                                <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                            </Button>
                        </Grid>
                        <Border Grid.Row="2" Height="1" Background="{DynamicResource SkuaBorderBrush}" />
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                            <Button Classes="skua-button" Command="{Binding OpenThemesFolderCommand}" ToolTip.Tip="Open the themes folder">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:MaterialIcon Kind="FolderOutline" Width="15" Height="15" />
                                    <TextBlock Text="Open themes folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="skua-button" Command="{Binding GetBackgroundsCommand}" ToolTip.Tip="Open the repository with more backgrounds">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:MaterialIcon Kind="OpenInNew" Width="15" Height="15" />
                                    <TextBlock Text="Get backgrounds" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
