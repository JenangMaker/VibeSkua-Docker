<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.CBOClassEquipmentUserControl">
    <!-- 2.x layout (upstream 2.1.2 CBOClassEquipmentView): a header bar with Refresh Inventory,
         then a card per combat mode with labelled slots. -->
    <UserControl.Styles>
        <Style Selector="Border.equip-card">
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="TextBlock.equip-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        </Style>
        <Style Selector="ComboBox.equip">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Border Grid.Row="0" Background="{DynamicResource SkuaSurfaceAltBrush}" BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <icons:MaterialIcon Kind="ShieldCrownOutline" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" />
                    <TextBlock Text="Equipment Slots Per Combat Mode" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Classes="skua-button" Height="28" Padding="10,0"
                        Command="{Binding RefreshInventoryCommand}" ToolTip.Tip="Refresh items from the player inventory">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <icons:MaterialIcon Kind="Refresh" Width="13" Height="13" />
                        <TextBlock Text="Refresh Inventory" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
            <Border Grid.Row="0" Grid.Column="0" Classes="equip-card">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                        <icons:MaterialIcon Kind="SwordCross" Width="15" Height="15" Foreground="{DynamicResource SkuaSuccessBrush}" />
                        <TextBlock Text="Solo Equipment" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="55,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                        <TextBlock Grid.Row="0" Classes="equip-label" Text="Helm" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Helms}" SelectedItem="{Binding SelectedSoloHelm}" />
                        <TextBlock Grid.Row="1" Classes="equip-label" Text="Armor" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Armors}" SelectedItem="{Binding SelectedSoloArmor}" />
                        <TextBlock Grid.Row="2" Classes="equip-label" Text="Cape" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Capes}" SelectedItem="{Binding SelectedSoloCape}" />
                        <TextBlock Grid.Row="3" Classes="equip-label" Text="Weapon" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedSoloWeapon}" />
                        <TextBlock Grid.Row="4" Classes="equip-label" Text="Pet" />
                        <ComboBox Grid.Row="4" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Pets}" SelectedItem="{Binding SelectedSoloPet}" />
                        <TextBlock Grid.Row="5" Classes="equip-label" Text="Ground" />
                        <ComboBox Grid.Row="5" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding GroundItems}" SelectedItem="{Binding SelectedSoloGroundItem}" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Classes="equip-card">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                        <icons:MaterialIcon Kind="SproutOutline" Width="15" Height="15" Foreground="{DynamicResource SkuaWarningBrush}" />
                        <TextBlock Text="Farm Equipment" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="55,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                        <TextBlock Grid.Row="0" Classes="equip-label" Text="Helm" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Helms}" SelectedItem="{Binding SelectedFarmHelm}" />
                        <TextBlock Grid.Row="1" Classes="equip-label" Text="Armor" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Armors}" SelectedItem="{Binding SelectedFarmArmor}" />
                        <TextBlock Grid.Row="2" Classes="equip-label" Text="Cape" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Capes}" SelectedItem="{Binding SelectedFarmCape}" />
                        <TextBlock Grid.Row="3" Classes="equip-label" Text="Weapon" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedFarmWeapon}" />
                        <TextBlock Grid.Row="4" Classes="equip-label" Text="Pet" />
                        <ComboBox Grid.Row="4" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Pets}" SelectedItem="{Binding SelectedFarmPet}" />
                        <TextBlock Grid.Row="5" Classes="equip-label" Text="Ground" />
                        <ComboBox Grid.Row="5" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding GroundItems}" SelectedItem="{Binding SelectedFarmGroundItem}" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Classes="equip-card">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                        <icons:MaterialIcon Kind="ShieldAccountOutline" Width="15" Height="15" Foreground="{DynamicResource SkuaAccentBrush}" />
                        <TextBlock Text="Dodge Equipment" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="55,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                        <TextBlock Grid.Row="0" Classes="equip-label" Text="Helm" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Helms}" SelectedItem="{Binding SelectedDodgeHelm}" />
                        <TextBlock Grid.Row="1" Classes="equip-label" Text="Armor" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Armors}" SelectedItem="{Binding SelectedDodgeArmor}" />
                        <TextBlock Grid.Row="2" Classes="equip-label" Text="Cape" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Capes}" SelectedItem="{Binding SelectedDodgeCape}" />
                        <TextBlock Grid.Row="3" Classes="equip-label" Text="Weapon" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedDodgeWeapon}" />
                        <TextBlock Grid.Row="4" Classes="equip-label" Text="Pet" />
                        <ComboBox Grid.Row="4" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Pets}" SelectedItem="{Binding SelectedDodgePet}" />
                        <TextBlock Grid.Row="5" Classes="equip-label" Text="Ground" />
                        <ComboBox Grid.Row="5" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding GroundItems}" SelectedItem="{Binding SelectedDodgeGroundItem}" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Classes="equip-card">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                        <icons:MaterialIcon Kind="CrownOutline" Width="15" Height="15" Foreground="{DynamicResource SkuaGoldBrush}" />
                        <TextBlock Text="Boss Equipment" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnDefinitions="55,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                        <TextBlock Grid.Row="0" Classes="equip-label" Text="Helm" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Helms}" SelectedItem="{Binding SelectedBossHelm}" />
                        <TextBlock Grid.Row="1" Classes="equip-label" Text="Armor" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Armors}" SelectedItem="{Binding SelectedBossArmor}" />
                        <TextBlock Grid.Row="2" Classes="equip-label" Text="Cape" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Capes}" SelectedItem="{Binding SelectedBossCape}" />
                        <TextBlock Grid.Row="3" Classes="equip-label" Text="Weapon" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedBossWeapon}" />
                        <TextBlock Grid.Row="4" Classes="equip-label" Text="Pet" />
                        <ComboBox Grid.Row="4" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding Pets}" SelectedItem="{Binding SelectedBossPet}" />
                        <TextBlock Grid.Row="5" Classes="equip-label" Text="Ground" />
                        <ComboBox Grid.Row="5" Grid.Column="1" Classes="equip" DropDownOpened="Equip_DropDownOpened"
                                  ItemsSource="{Binding GroundItems}" SelectedItem="{Binding SelectedBossGroundItem}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
