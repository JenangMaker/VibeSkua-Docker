<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.DropNotifyUserControl">
    <!-- 2.x layout: the watched drops with their count, add a drop, then the beep settings and
         Test beep. -->
    <Grid Margin="12" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
            <TextBlock Classes="section-label" Text="NOTIFY ON DROP" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="count"><TextBlock Text="{Binding NotifyDropList.Count}" /></Border>
            <TextBlock Grid.Column="3" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}"
                       Text="Delete removes the selected, Alt + Delete all" />
        </Grid>
        <Border Grid.Row="1" Classes="option-list">
            <ListBox ItemsSource="{Binding NotifyDropList}" SelectionMode="Multiple" Background="Transparent" BorderThickness="0" Padding="0"
                     b:Behave.DeleteSelected="{Binding RemoveDropsCommand}" b:Behave.AltDelete="{Binding RemoveAllDropsCommand}"
                     b:Behave.UnselectAllMenu="True" ToolTip.Tip="The items that beep when they drop">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding RemoveAllDropsCommand}" Header="Remove All" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Watermark="Drop name" Text="{Binding AddDropInput}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddDropCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="skua-button skua-primary w84" Command="{Binding AddDropCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="Plus" Width="15" Height="15" />
                    <TextBlock Text="Add" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="3" Padding="10,6" CornerRadius="8" Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,90,Auto,110,*,Auto" ColumnSpacing="8">
                <TextBlock Text="Beep" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding SoundCount}" b:Behave.OnlyNumbers="True" ToolTip.Tip="How many times to beep">
                    <TextBox.InnerRightContent>
                        <TextBlock Text="times" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    </TextBox.InnerRightContent>
                </TextBox>
                <TextBlock Grid.Column="2" Text="every" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Text="{Binding SoundDelay}" b:Behave.OnlyNumbers="True" ToolTip.Tip="Delay between beeps">
                    <TextBox.InnerRightContent>
                        <TextBlock Text="ms" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    </TextBox.InnerRightContent>
                </TextBox>
                <Button Grid.Column="5" Classes="skua-button" Command="{Binding TestBeepCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="VolumeHigh" Width="15" Height="15" />
                        <TextBlock Text="Test beep" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
