<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.OptionsPageView"
             x:DataType="v:OptionsPage"
             x:Name="Root">
    <!-- The 2.x options page (upstream 2.1.2's ApplicationOptionsView): search, section chips,
         then one list with a tinted header per section (under All) and a row per option. -->
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <TextBox Grid.Row="0" Watermark="{Binding Watermark, ElementName=Root}" Text="{Binding SearchText, Mode=TwoWay}">
            <TextBox.InnerLeftContent>
                <icons:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="10,0,0,0"
                                    Foreground="{DynamicResource SkuaMutedTextBrush}" />
            </TextBox.InnerLeftContent>
        </TextBox>

        <ListBox Grid.Row="1" Classes="chips" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="v:OptionGroup">
                    <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding Title}">
                        <icons:MaterialIcon Kind="{Binding Icon}" Width="14" Height="14" />
                        <TextBlock Text="{Binding ShortTitle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Count}" Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Classes="option-list" VerticalAlignment="Top">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredGroups}" Margin="0,0,0,-1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="v:OptionGroup">
                            <StackPanel>
                                <Border Classes="option-section"
                                        IsVisible="{Binding #Root.((v:OptionsPage)DataContext).ShowSectionHeaders}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <icons:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16"
                                                            Foreground="{DynamicResource SkuaAccentBrush}" />
                                        <TextBlock Classes="section-label" Text="{Binding Title}" />
                                        <Border Classes="count">
                                            <TextBlock Text="{Binding Count}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="option-row">
                                                <v:OptionItemUserControl />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
