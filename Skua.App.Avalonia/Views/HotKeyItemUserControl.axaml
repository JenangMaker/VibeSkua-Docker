<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.HotKeyItemUserControl">
    <!-- One hotkey as a 2.x row: name, the key as a pill (click to change), remove. -->
    <Border Classes="option-row" ToolTip.Tip="{Binding Description}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Classes="option-title" VerticalAlignment="Center" Text="{Binding Title, FallbackValue=HotKey}" />
            <Button Grid.Column="1" Classes="skua-button small" MinWidth="56" HorizontalContentAlignment="Center"
                    FontFamily="{DynamicResource MonoFont}" FontWeight="Bold"
                    Command="{Binding EditHotKeyCommand}" Content="{Binding KeyGesture}" ToolTip.Tip="Change the key" />
            <Button Grid.Column="2" Classes="icon danger-icon" Width="26" Height="26" Command="{Binding RemoveHotKeyCommand}"
                    ToolTip.Tip="Remove this hotkey">
                <icons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
            </Button>
        </Grid>
    </Border>
</UserControl>
