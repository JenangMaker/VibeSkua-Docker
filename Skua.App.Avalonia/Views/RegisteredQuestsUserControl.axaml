<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.RegisteredQuestsUserControl">
    <!-- 2.x card (upstream 2.1.2 runtime "Quests helper"): registered quests, then quest ID,
         optional reward ID and Add quest. -->
    <UserControl.Styles>
        <Style Selector="Border.helper">
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="ListBox.helper-list">
            <Setter Property="Background" Value="{DynamicResource SkuaPageBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
    </UserControl.Styles>
    <Border Classes="helper">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section-label" Text="QUESTS HELPER" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="skua-button small" Click="Remove_Click" Content="Remove selected"
                        ToolTip.Tip="Delete removes the selected ones, Alt + Delete removes all" />
            </Grid>
            <ListBox x:Name="List" Grid.Row="1" Classes="helper-list" MinHeight="44" ItemsSource="{Binding CurrentAutoQuests}" SelectionMode="Multiple"
                     b:Behave.DeleteSelected="{Binding RemoveQuestsCommand}" b:Behave.AltDelete="{Binding RemoveAllQuestsCommand}"
                     b:Behave.UnselectAllMenu="True" ToolTip.Tip="The quests the bot will try to complete">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding RemoveAllQuestsCommand}" Header="Remove All" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <Grid Grid.Row="2" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <TextBox Watermark="Quest ID" Text="{Binding AddQuestInput}" b:Behave.SelectAll="True">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddQuestCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <TextBox Grid.Column="1" Watermark="Reward ID" Text="{Binding RewardIdInput}" b:Behave.SelectAll="True"
                         ToolTip.Tip="Item ID for the quest reward choice. Leave empty or -1 to pick automatically.">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddQuestCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="2" Classes="skua-button skua-primary" Command="{Binding AddQuestCommand}" Content="Add quest" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
