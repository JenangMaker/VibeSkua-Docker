<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.CoreBotsOptionsView">
    <!-- 2.x layout (upstream 2.1.2 CoreBotsView): profile with Load / Save, then the tabs as
         top tabs, then the selected tab. Our tabs keep their own search (Options tab). -->
    <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                    Background="{DynamicResource SkuaSurfaceAltBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
                <icons:MaterialIcon Kind="AccountCircleOutline" Width="18" Height="18"
                                    Foreground="{DynamicResource SkuaAccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                <TextBlock Text="Profile" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                <TextBlock Text="{Binding CurrentPlayer}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding CurrentPlayer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="Not logged in" FontWeight="SemiBold" Foreground="{DynamicResource SkuaMutedTextBrush}"
                           IsVisible="{Binding CurrentPlayer, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="skua-button w84" Command="{Binding LoadCommand}" ToolTip.Tip="Load saved CoreBots settings">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                    <TextBlock Text="Load" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="skua-button skua-primary w84" Command="{Binding SaveCommand}" ToolTip.Tip="Save current CoreBots options">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" />
                    <TextBlock Text="Save" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ListBox Grid.Row="1" Classes="top-tabs-client"
                 ItemsSource="{Binding CoreBotsTabs}" SelectedItem="{Binding SelectedTab}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Classes="top-tabs-label" Text="{Binding Header}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ContentControl Grid.Row="2" Content="{Binding SelectedTab.Content}" />
    </Grid>
</UserControl>
