<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:Skua.Core.ViewModels;assembly=Skua.Core"
             x:Class="Skua.App.Avalonia.Views.CBOOptionItemUserControl">
    <!-- A CoreBots "other" option as a 2.x row: name and description left, editor right. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="vms:CBOBoolOptionItemViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="option-title" Text="{Binding Content}" />
                    <TextBlock Classes="option-description" Text="{Binding Description}"
                               IsVisible="{Binding Converter={StaticResource OptionLabel}, ConverterParameter=desc}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" IsChecked="{Binding Value}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="vms:CBOBoolChoiceOptionItemViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="option-title" Text="{Binding Content}" />
                    <TextBlock Classes="option-description" Text="{Binding Description}"
                               IsVisible="{Binding Converter={StaticResource OptionLabel}, ConverterParameter=desc}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <CheckBox Content="{Binding FirstChoice}" IsChecked="{Binding Value}" />
                    <CheckBox Content="{Binding SecondChoice}" IsChecked="{Binding !Value}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="vms:CBOChoiceOptionItemViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="option-title" Text="{Binding Content}" />
                    <TextBlock Classes="option-description" Text="{Binding Description}"
                               IsVisible="{Binding Converter={StaticResource OptionLabel}, ConverterParameter=desc}" />
                </StackPanel>
                <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center" ItemsSource="{Binding Options}" SelectedIndex="{Binding Value}" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>
    <ContentControl Content="{Binding}" />
</UserControl>
