<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.CBOptionsUserControl">
    <!-- 2.x layout (upstream 2.1.2 CBOptionsView): a search box, then two columns of compact
         option rows. Values bind both ways; the Save button of the window writes them. -->
    <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,6,0,0">
        <TextBox x:Name="SearchBox" Grid.Row="0" Watermark="Search CoreBots options">
            <TextBox.InnerLeftContent>
                <icons:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="10,0,0,0"
                                    Foreground="{DynamicResource SkuaMutedTextBrush}" />
            </TextBox.InnerLeftContent>
        </TextBox>
        <Border Grid.Row="1" Classes="option-list" VerticalAlignment="Top">
            <!-- A fixed scrollbar lane, so the right column fields don't sit under an overlay scrollbar -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
                <ItemsControl x:Name="OptionsList" Margin="0,0,0,-1" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <!-- A line between the columns -->
                        <Style Selector="ContentPresenter:nth-child(2n+1) > Border.option-row">
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="option-row" MinHeight="38" Padding="12,3">
                                <ContentControl Content="{Binding}">
                                    <ContentControl.ContentTemplate>
                                        <b:OptionTemplateSelector>
                                            <b:OptionTemplateSelector.BoolTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" ToolTip.Tip="{Binding Description}">
                                                        <TextBlock Classes="option-title" Text="{Binding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                                                                      IsChecked="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </b:OptionTemplateSelector.BoolTemplate>
                                            <b:OptionTemplateSelector.IntTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" ToolTip.Tip="{Binding Description}">
                                                        <TextBlock Classes="option-title" Text="{Binding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Classes="option-field" Width="124" VerticalAlignment="Center">
                                                            <TextBox Classes="option-pill-input" TextAlignment="Right"
                                                                     Text="{Binding Value}" b:Behave.OnlyNumbers="True" b:Behave.SelectAll="True" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </b:OptionTemplateSelector.IntTemplate>
                                            <b:OptionTemplateSelector.StringTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" ToolTip.Tip="{Binding Description}">
                                                        <TextBlock Classes="option-title" Text="{Binding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Classes="option-field" Width="160" VerticalAlignment="Center">
                                                            <TextBox Classes="option-pill-input" Watermark="{Binding Content}"
                                                                     Text="{Binding Value}" b:Behave.SelectAll="True" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </b:OptionTemplateSelector.StringTemplate>
                                        </b:OptionTemplateSelector>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
