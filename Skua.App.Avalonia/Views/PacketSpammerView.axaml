<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.PacketSpammerView">
    <!-- 2.x layout (upstream 2.1.2 PacketSpammerView): Start / Stop with the delay and Send to
         client; the queue with Load / Save / Clear; then the packet box with Add and Send now. -->
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,Auto,120,Auto,Auto,*" ColumnSpacing="8">
            <Panel>
                <Button Classes="skua-button skua-primary w140" Command="{Binding ToggleSpammerCommand}" IsVisible="{Binding !SpammerCommand.IsRunning}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="PlayCircleOutline" Width="15" Height="15" />
                    <TextBlock Text="Start" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
                <Button Classes="skua-button skua-danger w140" Command="{Binding ToggleSpammerCommand}" IsVisible="{Binding SpammerCommand.IsRunning}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="StopCircleOutline" Width="15" Height="15" />
                    <TextBlock Text="Stop" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            </Panel>
            <TextBlock Grid.Column="1" Text="Every" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" IsEnabled="{Binding !SpammerCommand.IsRunning}" b:Behave.OnlyNumbers="True" ToolTip.Tip="Delay between packets"
                     Text="{Binding SpamDelay, Converter={StaticResource StringToIntConverter}}">
                <TextBox.InnerRightContent>
                    <TextBlock Text="ms" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </TextBox.InnerRightContent>
            </TextBox>
            <ToggleSwitch Grid.Column="3" OnContent="" OffContent="" MinWidth="0" Margin="8,0,0,0" VerticalAlignment="Center" IsChecked="{Binding SendToClient}" />
            <TextBlock Grid.Column="4" Text="Send to client" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6" IsEnabled="{Binding !SpammerCommand.IsRunning}">
            <TextBlock Classes="section-label" Text="QUEUE" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="count"><TextBlock Text="{Binding Packets.Count}" /></Border>
            <Button Classes="skua-button small" Grid.Column="3" Command="{Binding LoadSpammerCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                    <TextBlock Text="Load" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="skua-button small" Grid.Column="4" Command="{Binding SaveSpammerCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="ContentSave" Width="15" Height="15" />
                    <TextBlock Text="Save" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="skua-button small skua-danger-soft" Grid.Column="5" Command="{Binding ClearPacketsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" />
                    <TextBlock Text="Clear" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="2" Classes="option-list">
            <ListBox x:Name="PacketsBox" ItemsSource="{Binding Packets}" SelectedIndex="{Binding SelectedIndex}" b:Behave.ScrollToSelected="True"
                     Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,3" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon danger-icon" Width="24" Height="24" ToolTip.Tip="Remove"
                                    IsEnabled="{Binding !$parent[ListBox].DataContext.SpammerCommand.IsRunning}"
                                    Command="{Binding $parent[ListBox].DataContext.RemovePacketCommand}" CommandParameter="{Binding}">
                                <icons:MaterialIcon Kind="Close" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Watermark="%xt%zm%...  packet to add or send" FontFamily="{DynamicResource MonoFont}" Text="{Binding PacketText}" b:Behave.SelectAll="True" />
            <Button Classes="skua-button" Grid.Column="1" Command="{Binding AddPacketCommand}" IsEnabled="{Binding !SpammerCommand.IsRunning}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="Plus" Width="15" Height="15" />
                    <TextBlock Text="Add" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="skua-button skua-primary" Grid.Column="2" Command="{Binding SendPacketCommand}" IsEnabled="{Binding !SpammerCommand.IsRunning}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="Send" Width="15" Height="15" />
                    <TextBlock Text="Send now" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
