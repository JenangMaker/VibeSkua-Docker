<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.LoadoutsView">
    <!-- 2.x layout (upstream 2.1.2 LoadoutsView): saved loadouts on the left with Save current
         gear; the selected loadout's name and slots on the right with Delete and Equip. -->
    <UserControl.Styles>
        <Style Selector="Run.enh">
            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="12" ColumnDefinitions="*,12,1.4*" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <TextBlock Classes="section-label" Text="SAVED LOADOUTS" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="count">
                <TextBlock Text="{Binding Loadouts.Count}" />
            </Border>
            <Button Grid.Column="2" Classes="icon icon-muted" Width="26" Height="26" Command="{Binding RefreshCommand}" ToolTip.Tip="Reload the loadouts">
                <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
            </Button>
        </Grid>
        <Border Grid.Row="1" Grid.Column="0" Classes="option-list">
            <ListBox ItemsSource="{Binding Loadouts}" SelectedItem="{Binding SelectedLoadout}" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,7" />
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Button Grid.Row="2" Grid.Column="0" Classes="skua-button" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Command="{Binding SaveCurrentCommand}" ToolTip.Tip="Save the gear you are wearing as a new loadout">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:MaterialIcon Kind="Plus" Width="16" Height="16" />
                <TextBlock Text="Save current gear" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="*,Auto">
            <TextBlock Classes="section-label" Text="LOADOUT" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="skua-button small" Command="{Binding ShowCurrentCommand}" ToolTip.Tip="Show the gear you are wearing">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <icons:MaterialIcon Kind="EyeOutline" Width="14" Height="14" />
                    <TextBlock Text="Show current gear" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
            <TextBox Watermark="Select a loadout" Text="{Binding SelectedLoadoutName, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="Loadout name">
                <TextBox.InnerLeftContent>
                    <icons:MaterialIcon Kind="CardAccountDetailsOutline" Width="15" Height="15" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <Border Grid.Row="1" Classes="option-list">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Classes="option-row">
                            <Grid ColumnDefinitions="Auto,70,*" ColumnSpacing="8">
                                <icons:MaterialIcon Kind="ShieldAccountOutline" Width="16" Height="16" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Class" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding SelectedLoadout.Class}" /><Run Classes="enh" Text="{Binding SelectedLoadout.ClassEnhancement, StringFormat='  {0}'}" /></TextBlock>
                            </Grid>
                        </Border>
                        <Border Classes="option-row">
                            <Grid ColumnDefinitions="Auto,70,*" ColumnSpacing="8">
                                <icons:MaterialIcon Kind="TshirtCrewOutline" Width="16" Height="16" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Armor" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding SelectedLoadout.Armor}" /></TextBlock>
                            </Grid>
                        </Border>
                        <Border Classes="option-row">
                            <Grid ColumnDefinitions="Auto,70,*" ColumnSpacing="8">
                                <icons:MaterialIcon Kind="Sword" Width="16" Height="16" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Weapon" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding SelectedLoadout.Weapon}" /><Run Classes="enh" Text="{Binding SelectedLoadout.WeaponEnhancement, StringFormat='  {0}'}" /></TextBlock>
                            </Grid>
                        </Border>
                        <Border Classes="option-row">
                            <Grid ColumnDefinitions="Auto,70,*" ColumnSpacing="8">
                                <icons:MaterialIcon Kind="HardHat" Width="16" Height="16" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Helm" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding SelectedLoadout.Helm}" /><Run Classes="enh" Text="{Binding SelectedLoadout.HelmEnhancement, StringFormat='  {0}'}" /></TextBlock>
                            </Grid>
                        </Border>
                        <Border Classes="option-row">
                            <Grid ColumnDefinitions="Auto,70,*" ColumnSpacing="8">
                                <icons:MaterialIcon Kind="Flag" Width="16" Height="16" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Cape" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding SelectedLoadout.Cape}" /><Run Classes="enh" Text="{Binding SelectedLoadout.CapeEnhancement, StringFormat='  {0}'}" /></TextBlock>
                            </Grid>
                        </Border>
                        <Border Classes="option-row">
                            <Grid ColumnDefinitions="Auto,70,*" ColumnSpacing="8">
                                <icons:MaterialIcon Kind="Paw" Width="16" Height="16" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Pet" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding SelectedLoadout.Pet}" /></TextBlock>
                            </Grid>
                        </Border>
                        <Border Classes="option-row" BorderThickness="0">
                            <Grid ColumnDefinitions="Auto,70,*" ColumnSpacing="8">
                                <icons:MaterialIcon Kind="Necklace" Width="16" Height="16" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Amulet" VerticalAlignment="Center" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding SelectedLoadout.Amulet}" /></TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="Auto,*,Auto">
            <Button Classes="skua-button skua-danger-soft" Command="{Binding DeleteLoadoutCommand}" ToolTip.Tip="Delete this loadout">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" />
                    <TextBlock Text="Delete" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="skua-button skua-primary w112" Command="{Binding EquipLoadoutCommand}" ToolTip.Tip="Equip this loadout">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="TshirtCrew" Width="15" Height="15" />
                    <TextBlock Text="Equip" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
