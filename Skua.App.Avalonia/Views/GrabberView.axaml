<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.GrabberView">
    <!-- 2.x layout (upstream 2.1.2 GrabberView): what to grab in a sidebar, the list on the right. -->
    <Grid ColumnDefinitions="180,*">
        <ListBox Margin="12,12,0,12" ItemsSource="{Binding GrabberTabs}" SelectedItem="{Binding SelectedTab}"
                 Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <v:GrabberListUserControl Grid.Column="1" DataContext="{Binding SelectedTab}" />
    </Grid>
</UserControl>
