<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.JunkItemsUserControl">
    <!-- 2.x layout (upstream 2.1.2 JunkItemsView): search and refresh, the filters, mark / unmark,
         the item list with junk and AC chips, then skip warning and the sell actions. -->
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="SearchBox" Watermark="Search by ID or name">
                <TextBox.InnerLeftContent>
                    <icons:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="1" Classes="skua-button" Width="34" Padding="0" Command="{Binding RefreshCommand}" ToolTip.Tip="Reload the inventory">
                <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
            </Button>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <ComboBox x:Name="CategoryFilter" HorizontalAlignment="Stretch" ItemsSource="{Binding CategoryOptions}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" ToolTip.Tip="Filter by item category" />
            <ComboBox x:Name="AcFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" ToolTip.Tip="Filter AC items or non-AC items">
                <ComboBoxItem Content="All Items" />
                <ComboBoxItem Content="AC Items" />
                <ComboBoxItem Content="Non-AC Items" />
            </ComboBox>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
            <TextBlock Classes="section-label" Text="JUNK" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="count">
                <TextBlock Text="{Binding TotalJunk}" />
            </Border>
            <Button Grid.Column="3" Classes="skua-button small" Command="{Binding MarkAsJunkCommand}" ToolTip.Tip="Mark the ticked items as junk">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <icons:MaterialIcon Kind="TagOutline" Width="14" Height="14" />
                    <TextBlock Text="Mark as junk" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="skua-button small" Command="{Binding UnmarkAsJunkCommand}" Content="Unmark"
                    ToolTip.Tip="Unmark the ticked items" />
        </Grid>
        <Border Grid.Row="3" Classes="option-list">
            <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,3" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                            <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2" Classes="chip gold" IsVisible="{Binding IsAc}">
                                <TextBlock Text="AC" />
                            </Border>
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource SkuaMutedTextBrush}" Text="{Binding QuantityDisplay}" />
                            <Border Grid.Column="4" Classes="chip danger" IsVisible="{Binding IsJunk}">
                                <TextBlock Text="Junk" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <CheckBox VerticalAlignment="Center" Content="Skip sell warning" IsChecked="{Binding SkipSellWarning}" />
            <Button Grid.Column="2" Classes="skua-button" Command="{Binding UnmarkAllJunkCommand}" Content="Unmark all" />
            <Button Grid.Column="3" Classes="skua-button skua-danger" Command="{Binding SellAllJunkCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="DeleteSweepOutline" Width="15" Height="15" />
                    <TextBlock Text="{Binding TotalJunk, StringFormat='Sell all junk ({0})'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
