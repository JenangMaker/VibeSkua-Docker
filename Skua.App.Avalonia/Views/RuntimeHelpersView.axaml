<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.RuntimeHelpersView">
    <!-- 2.x layout (upstream 2.1.2 runtime window): drops helper on the left, quests and boosts
         helpers on the right, each as a card. -->
    <Grid Margin="12" ColumnDefinitions="*,12,*" RowDefinitions="*,12,Auto">
        <v:ToPickupDropsUserControl Grid.RowSpan="3" Grid.Column="0" DataContext="{Binding ToPickupDropsViewModel}" />
        <v:RegisteredQuestsUserControl Grid.Row="0" Grid.Column="2" DataContext="{Binding RegisteredQuestsViewModel}" />
        <v:BoostsUserControl Grid.Row="2" Grid.Column="2" DataContext="{Binding BoostsViewModel}" />
    </Grid>
</UserControl>
