<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.ScriptLoaderView">
    <Grid Margin="6" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Margin="0,0,0,3" HorizontalAlignment="Center" Classes="h6"
                       ToolTip.Tip="{Binding ScriptErrorToolTip}">
                <Run Text="Status:" />
                <Run Text="{Binding ScriptStatus, FallbackValue='[No script]'}" />
            </TextBlock>
            <TextBlock Margin="0,3" HorizontalAlignment="Center" FontSize="20"
                       Text="{Binding LoadedScript, FallbackValue='No script loaded'}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,3" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <Button Grid.Row="0" Grid.Column="0" Margin="0,0,3,3" HorizontalAlignment="Stretch"
                    Command="{Binding LoadScriptCommand}" Content="Load Script" />
            <Button Grid.Row="0" Grid.Column="1" Margin="3,0,0,3" HorizontalAlignment="Stretch"
                    Command="{Binding OpenVSCodeCommand}" Content="Open VSCode" />
            <Button Grid.Row="1" Grid.Column="0" Margin="0,3,3,3" HorizontalAlignment="Stretch"
                    Command="{Binding EditScriptCommand}" Content="Edit Script" />
            <Button Grid.Row="1" Grid.Column="1" Margin="3,3,0,3" HorizontalAlignment="Stretch"
                    Command="{Binding OpenScriptRepoCommand}" Content="Search Scripts" />
            <Button Grid.Row="2" Grid.ColumnSpan="2" Margin="0,3" HorizontalAlignment="Stretch"
                    Command="{Binding EditScriptConfigCommand}" Content="Edit Script Options"
                    IsEnabled="{Binding ToggleScriptEnabled}" />
            <Button Grid.Row="3" Grid.Column="0" Margin="0,3,3,0" HorizontalAlignment="Stretch" Classes="accent"
                    Command="{Binding ToggleScriptCommand}" IsEnabled="{Binding ToggleScriptEnabled}"
                    Content="{Binding ScriptManager.ScriptRunning, Converter={StaticResource BoolText}, ConverterParameter='Stop Script|Start Script'}" />
            <Button Grid.Row="3" Grid.Column="1" Margin="3,3,0,0" HorizontalAlignment="Stretch" Classes="accent"
                    Command="{Binding TogglePauseScriptCommand}" IsEnabled="{Binding ScriptManager.ScriptRunning}"
                    Content="{Binding ScriptManager.ScriptPaused, Converter={StaticResource BoolText}, ConverterParameter='Resume Script|Pause Script'}" />
        </Grid>
        <ContentControl Grid.Row="2" Margin="0,3" Content="{Binding ScriptLogs}" />
        <Button Grid.Row="3" Margin="0,3,0,0" HorizontalAlignment="Stretch"
                Command="{Binding OpenBrowserFormCommand}" Content="Report Issues to @Tato2/@bogalj" />
    </Grid>
</UserControl>
