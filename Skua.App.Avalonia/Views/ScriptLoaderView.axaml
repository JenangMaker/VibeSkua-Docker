<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.ScriptLoaderView">
    <!-- 2.x layout (upstream 2.1.2 ScriptLoaderView): loaded-script card with a status pill, the
         action buttons with icons, the script log with its actions, the report button. -->
    <UserControl.Styles>
        <Style Selector="Button.loader">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.loader TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.log-action">
            <Setter Property="Width" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12" RowSpacing="10">
        <Border Grid.Row="0" Background="{DynamicResource SkuaSurfaceBrush}" BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="LOADED SCRIPT" FontSize="9" FontWeight="Bold" LetterSpacing="0.5"
                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    <TextBlock FontSize="13" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis"
                               Text="{Binding LoadedScript}" ToolTip.Tip="{Binding LoadedScript}"
                               IsVisible="{Binding LoadedScript, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock FontSize="13" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}" Text="No script loaded"
                               Foreground="{DynamicResource SkuaMutedTextBrush}"
                               IsVisible="{Binding LoadedScript, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SkuaSurfaceAltBrush}" BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="8,3" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding ScriptErrorToolTip}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <!-- Status dot: muted idle, green running, amber paused or compiling, red on error -->
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Classes.running="{Binding ScriptStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='[Running]'}"
                                 Classes.paused="{Binding ScriptStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='[Paused]'}"
                                 Classes.compiling="{Binding ScriptStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Compiling...'}"
                                 Classes.error="{Binding ScriptStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='[Error]'}">
                            <Ellipse.Styles>
                                <Style Selector="Ellipse"><Setter Property="Fill" Value="{DynamicResource SkuaMutedTextBrush}" /></Style>
                                <Style Selector="Ellipse.running"><Setter Property="Fill" Value="{DynamicResource SkuaSuccessBrush}" /></Style>
                                <Style Selector="Ellipse.paused, Ellipse.compiling"><Setter Property="Fill" Value="{DynamicResource SkuaWarningBrush}" /></Style>
                                <Style Selector="Ellipse.error"><Setter Property="Fill" Value="{DynamicResource SkuaDangerBrush}" /></Style>
                            </Ellipse.Styles>
                        </Ellipse>
                        <TextBlock FontSize="10" FontWeight="Bold" Text="{Binding ScriptStatus, FallbackValue='[No script]'}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
            <Button Grid.Row="0" Grid.Column="0" Classes="skua-button loader" Command="{Binding LoadScriptCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="FolderOpen" Width="15" Height="15" />
                    <TextBlock Text="Load Script" />
                </StackPanel>
            </Button>
            <Button Grid.Row="0" Grid.Column="1" Classes="skua-button loader" Command="{Binding OpenVSCodeCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="MicrosoftVisualStudioCode" Width="15" Height="15" />
                    <TextBlock Text="Open VSCode" />
                </StackPanel>
            </Button>
            <Button Grid.Row="1" Grid.Column="0" Classes="skua-button loader" Command="{Binding EditScriptCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="FileEdit" Width="15" Height="15" />
                    <TextBlock Text="Edit Script" />
                </StackPanel>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" Classes="skua-button loader" Command="{Binding OpenScriptRepoCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="FolderSearch" Width="15" Height="15" />
                    <TextBlock Text="Search Scripts" />
                </StackPanel>
            </Button>
            <Button Grid.Row="2" Grid.ColumnSpan="2" Classes="skua-button loader" Command="{Binding EditScriptConfigCommand}"
                    IsEnabled="{Binding ToggleScriptEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="Cog" Width="15" Height="15" />
                    <TextBlock Text="Edit Script Options" />
                </StackPanel>
            </Button>
            <Button Grid.Row="3" Grid.Column="0" Classes="skua-button loader"
                    Classes.skua-danger="{Binding ScriptManager.ScriptRunning}"
                    Classes.skua-primary="{Binding !ScriptManager.ScriptRunning}"
                    Command="{Binding ToggleScriptCommand}" IsEnabled="{Binding ToggleScriptEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="Play" Width="15" Height="15" IsVisible="{Binding !ScriptManager.ScriptRunning}" />
                    <icons:MaterialIcon Kind="Stop" Width="15" Height="15" IsVisible="{Binding ScriptManager.ScriptRunning}" />
                    <TextBlock FontWeight="Bold"
                               Text="{Binding ScriptManager.ScriptRunning, Converter={StaticResource BoolText}, ConverterParameter='Stop Script|Start Script'}" />
                </StackPanel>
            </Button>
            <Button Grid.Row="3" Grid.Column="1" Classes="skua-button loader"
                    Command="{Binding TogglePauseScriptCommand}" IsEnabled="{Binding ScriptManager.ScriptRunning}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:MaterialIcon Kind="Pause" Width="15" Height="15" IsVisible="{Binding !ScriptManager.ScriptPaused}" />
                    <icons:MaterialIcon Kind="Play" Width="15" Height="15" IsVisible="{Binding ScriptManager.ScriptPaused}" />
                    <TextBlock Text="{Binding ScriptManager.ScriptPaused, Converter={StaticResource BoolText}, ConverterParameter='Resume Script|Pause Script'}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Classes="section-label" Text="SCRIPT LOG" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="count">
                    <TextBlock Text="{Binding ScriptLogs.Logs.Count}" />
                </Border>
                <Button Grid.Column="3" Classes="skua-button small log-action" Click="Copy_Click"
                        ToolTip.Tip="Copy the selected lines, or the whole log">
                    <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                </Button>
                <Button Grid.Column="4" Classes="skua-button small log-action" Click="Deselect_Click" ToolTip.Tip="Clear the selection">
                    <icons:MaterialIcon Kind="SelectionRemove" Width="14" Height="14" />
                </Button>
                <Button Grid.Column="5" Classes="skua-button small log-action" Command="{Binding ScriptLogs.SaveLogCommand}"
                        ToolTip.Tip="Save the log to a file">
                    <icons:MaterialIcon Kind="ContentSave" Width="14" Height="14" />
                </Button>
                <Button Grid.Column="6" Classes="skua-button small skua-danger-soft log-action" Command="{Binding ScriptLogs.ClearLogCommand}"
                        ToolTip.Tip="Clear the log">
                    <icons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
                </Button>
            </Grid>
            <v:LogTabUserControl Grid.Row="1" DataContext="{Binding ScriptLogs}" ShowCopyHint="False" />
        </Grid>

        <Button Grid.Row="3" Classes="skua-button outline loader" Height="30" Foreground="{DynamicResource SkuaMutedTextBrush}"
                Command="{Binding OpenBrowserFormCommand}" ToolTip.Tip="Open the feedback and issue form">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14" />
                <TextBlock Text="Report Issues to @Tato2/@bogalj" FontWeight="Normal" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
