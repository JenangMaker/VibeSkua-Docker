<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Skua.App.Avalonia"
             x:Class="Skua.App.Avalonia.Views.LogTabUserControl"
             x:Name="Root">
    <!-- 2.x layout (upstream 2.1.2 LogTabUserControl): the log in a framed list, the line count and
         a copy hint under it. The actions (Copy, Deselect, Save, Clear) sit in the window header. -->
    <Grid RowDefinitions="*,Auto" RowSpacing="6">
        <Border Grid.Row="0" Classes="option-list">
            <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" SelectionMode="Multiple" Background="Transparent"
                     b:Behave.CopySelected="True" b:Behave.ScrollToEnd="True">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="Copy_Click" />
                        <MenuItem Header="Deselect" Click="Deselect_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <TextBlock FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}">
                <Run Text="{Binding Logs.Count}" />
                <Run Text="lines" />
            </TextBlock>
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}"
                       Text="Ctrl+C or right-click to copy selected lines" IsVisible="{Binding #Root.ShowCopyHint}" />
        </Grid>
    </Grid>
</UserControl>
