<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Skua.App.Avalonia.Views"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.GameOptionsView">
    <!-- 2.x layout (upstream 2.1.2): search, Visuals / Combat / Drops / Relogin / Gameplay chips,
         option rows; the relogin server and Reset / Default / Save below. -->
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,8" CornerRadius="8"
                Background="{DynamicResource SkuaSurfaceBrush}" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <icons:MaterialIcon Kind="ServerNetwork" Width="14" Height="14" Foreground="{DynamicResource SkuaAccentBrush}" />
                    <TextBlock Classes="option-title" Text="Relogin Server" VerticalAlignment="Center" />
                </StackPanel>
                <ComboBox Grid.Column="1" MinWidth="160" HorizontalAlignment="Left" PlaceholderText="Relogin Server"
                          ItemsSource="{Binding ServersList}" SelectedItem="{Binding SelectedServer}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Classes="small" Command="{Binding ResetOptionsCommand}" Content="Reset"
                            ToolTip.Tip="Resets to the user saved default values. If no user defaults are found, resets to the application default." />
                    <Button Classes="small" Command="{Binding ResetDefaultOptionsCommand}" Content="Default"
                            ToolTip.Tip="Reset to the application default values." />
                    <Button Classes="small skua-primary" Command="{Binding SaveOptionsCommand}" Content="Save" />
                </StackPanel>
            </Grid>
        </Border>
        <v:OptionsPageView x:Name="Page" Watermark="Search game options" />
    </DockPanel>
</UserControl>
