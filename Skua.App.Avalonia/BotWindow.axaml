<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theming="clr-namespace:Skua.App.Avalonia.Theming"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Skua.App.Avalonia.BotWindow"
        Title="{Binding SelectedItem.Title}"
        Width="800"
        Height="450"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Skua.App.Avalonia/Assets/SkuaIcon.ico">
    <!-- 2.x toolbar and drawer. Skua.WPF's BotWindow: a drawer listing every bot control, the
         selected one's view beside it. -->
    <DockPanel>
        <theming:WindowTitleBar DockPanel.Dock="Top" />
        <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="MenuToggle" Classes="flat" Width="32" Height="32" Padding="0" ToolTip.Tip="Menu"
                              IsChecked="{Binding #Split.IsPaneOpen}">
                    <icons:MaterialIcon Kind="Menu" Width="18" Height="18" />
                </ToggleButton>
                <Button Classes="icon icon-muted" Width="32" Height="32" Command="{Binding MovePrevCommand}" ToolTip.Tip="Previous Item">
                    <icons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                </Button>
                <Button Classes="icon icon-muted" Width="32" Height="32" Command="{Binding MoveNextCommand}" ToolTip.Tip="Next Item">
                    <icons:MaterialIcon Kind="ArrowRight" Width="18" Height="18" />
                </Button>
                <Button Classes="icon icon-muted" Width="32" Height="32" Command="{Binding HomeCommand}" ToolTip.Tip="Home">
                    <icons:MaterialIcon Kind="Home" Width="18" Height="18" />
                </Button>
            </StackPanel>
        </Border>
        <SplitView x:Name="Split" DisplayMode="Overlay" OpenPaneLength="240"
                   PaneBackground="{DynamicResource SkuaSurfaceBrush}" Background="{DynamicResource SkuaPageBrush}">
            <SplitView.Pane>
                <DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="10" Watermark="Search">
                        <TextBox.InnerLeftContent>
                            <icons:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <ListBox x:Name="ViewsList"
                             SelectedItem="{Binding SelectedItem}"
                             SelectionChanged="ViewsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="4,2,0,2" Text="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </SplitView.Pane>
            <ContentControl Content="{Binding SelectedItem}" />
        </SplitView>
    </DockPanel>
</Window>
