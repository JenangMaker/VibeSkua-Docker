<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VibeSkua's UI for Linux: the WPF client's views ported to Avalonia, over
    Skua.Linux's runtime (Skua.Core driving skua.swf in the vibeskua-web
    Ruffle page). The game itself stays in that page; these are the bot's
    windows, as in the Windows app minus its embedded Flash control.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>Assets\SkuaIcon.ico</ApplicationIcon>
    <!-- The WPF views bind by name at runtime; keep that rather than
         annotating every template with x:DataType. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.4.1" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="11.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Linux\Skua.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Thread pool threads stop spinning before they sleep. Every bridge round
         trip (about 90 a second idle, 200+ in a fight) woke threads that then
         spun: about a third of a tab's CPU, idle or fighting, measured. Wake-up
         latency is microseconds; bridge calls take milliseconds.
         DOTNET_ThreadPool_UnfairSemaphoreSpinLimit still overrides it. -->
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.UnfairSemaphoreSpinLimit" Value="0" />
  </ItemGroup>

</Project>
