<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in System.Windows.Forms for Skua.Host on Linux, which has no
    WinForms. Community scripts include CoreBots.cs, which has
    `using System.Windows.Forms;` and one WinForms dialog, so without this no
    script compiles. It only has to compile: every member either does nothing
    or throws PlatformNotSupportedException. See Stubs.cs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Windows.Forms</AssemblyName>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Not Skua's AppInfo (Directory.Build.props): this is not a Skua assembly. -->
  <ItemGroup>
    <Compile Remove="$(MSBuildThisFileDirectory)..\Shared\AppInfo.cs" />
  </ItemGroup>

</Project>
