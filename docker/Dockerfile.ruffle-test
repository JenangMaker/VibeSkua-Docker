# VibeSkua — Ruffle bridge test, headless on Linux
# -------------------------------------------------
# Unlike the other two Dockerfiles in this folder, this one does not build
# VibeSkua — it RUNS something: the Skua ExternalInterface bridge against the
# live AQW client, on Ruffle instead of Flash ActiveX, with no desktop and no
# Windows anywhere.
#
#   docker compose run --rm ruffle-test
#
# Exits 0 on PASS, 1 on FAIL, so it works as a CI check.
# See docs/ruffle-test/README.md for what it proves.

ARG NODE_IMAGE=node:22-bookworm-slim

FROM ${NODE_IMAGE} AS run

# Chrome's runtime libraries. Puppeteer downloads the browser itself at
# npm-install time; these are the shared objects it links against.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      fonts-liberation \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libcairo2 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libexpat1 \
      libgbm1 \
      libglib2.0-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libx11-6 \
      libxcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first so npm install caches independently of the harness source.
COPY docs/ruffle-test/package.json ./
RUN npm install --omit=dev --no-audit --no-fund

# Harness. credentials.local.json and node_modules are excluded by .dockerignore
# — never bake a credential into an image layer.
COPY docs/ruffle-test/ ./

# setup.js normally copies this out of the repo tree, which isn't in the build
# context at that path; stage it directly and let setup.js keep it.
COPY Skua.AS3/skua/bin/skua.swf ./public/skua.swf
RUN node setup.js

# Supply credentials at RUN time only, never at build time:
#   docker compose run --rm -e AQW_USER=... -e AQW_PASS=... ruffle-test
ENV RUN_SECONDS=90

CMD ["node", "run-headless.js"]
