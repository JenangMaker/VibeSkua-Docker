# Launched by the KasmVNC base image once the X session is up.
#
# Keep this file trivial and POSIX: openbox-autostart sources it with /bin/sh
# (dash), ignoring any shebang. And the base image copies it into /config only
# when no copy exists yet, so with /config on a volume an edited version would
# never arrive (custom-cont-init.d/10-vibeskua-autostart now refreshes it).
# The real launcher is /app/launch.sh, which ships in the image.
exec /bin/bash /app/launch.sh
