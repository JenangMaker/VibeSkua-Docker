#!/usr/bin/with-contenv bash
# The base image copies /defaults/autostart into /config only if none exists,
# so a /config volume kept across recreates pins the first image's launcher.
# Always refresh it from the image.
mkdir -p /config/.config/openbox
cp /defaults/autostart /config/.config/openbox/autostart
chown -R abc:abc /config/.config/openbox
echo "[vibeskua] refreshed /config/.config/openbox/autostart"
