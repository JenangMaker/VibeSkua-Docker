#!/usr/bin/with-contenv bash
# The base image copies /defaults/autostart into /config only if none exists,
# so a /config volume kept across recreates pins the first image's launcher.
# Always refresh it from the image.
mkdir -p /config/.config/openbox
cp /defaults/autostart /config/.config/openbox/autostart
echo "[vibeskua] refreshed /config/.config/openbox/autostart"

# Openbox focuses a window on every mouse press in it. Skua embeds the game
# window inside its own, so a click in the game (the chat box, say) made
# Openbox give the keyboard to Skua's top window: the game lost the keys and
# nothing could be typed into it, with either game build. Generated from the
# system rc.xml: presses in a window raise it without focusing it, and focus
# follows the mouse instead, so Skua's windows still get the keyboard when the
# pointer is over them (Skua moves it between its own window and the game).
# A rc.xml without the marker below is the user's own and is left alone.
rc=/config/.config/openbox/rc.xml
marker='<!-- vibeskua: generated -->'
if [ -f /etc/xdg/openbox/rc.xml ] && { [ ! -f "$rc" ] || grep -qF "$marker" "$rc"; }; then
  sed -e '/<context name="Client">/,/<\/context>/{/<action name="Focus"\/>/d}' \
      -e 's#<followMouse>no</followMouse>#<followMouse>yes</followMouse>#' \
      -e "0,/<openbox_config/s#<openbox_config#${marker}\n<openbox_config#" \
      /etc/xdg/openbox/rc.xml > "$rc.tmp" && mv "$rc.tmp" "$rc"
  echo "[vibeskua] wrote $rc (click raises, focus follows the mouse)"
else
  echo "[vibeskua] kept $rc (not generated by VibeSkua)"
fi
chown -R abc:abc /config/.config/openbox
