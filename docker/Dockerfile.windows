# escape=`
#
# VibeSkua — Windows build container
# ----------------------------------
# Compiles Skua.sln the way the project's own toolchain does (Windows + .NET 10
# SDK + WindowsDesktop targeting pack) and hands the release layout back to the
# host.
#
# This image BUILDS VibeSkua. It cannot RUN it: the client is a WPF app that
# hosts the Flash ActiveX control and hooks the Flash process, which needs a
# real interactive Windows desktop session. See DOCKER.md.
#
# Requires a Windows container host (Windows Pro/Enterprise/Server, or a
# GitHub Actions windows-* runner). Match the ltsc tag to your host build.

ARG SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0-windowsservercore-ltsc2022
ARG EXPORT_IMAGE=mcr.microsoft.com/windows/servercore:ltsc2022

# ---------------------------------------------------------------- restore ---
FROM ${SDK_IMAGE} AS restore
SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue';"]

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 `
    DOTNET_NOLOGO=1 `
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 `
    NUGET_XMLDOC_MODE=skip

WORKDIR C:/src

# Project files first, so NuGet restore is cached independently of source edits.
COPY Skua.sln Directory.Build.props ./
COPY Shared/ Shared/
COPY Skua.AS3/Skua.AS3.csproj                                 Skua.AS3/
COPY Skua.Core/Skua.Core.csproj                               Skua.Core/
COPY Skua.Core.Generators/Skua.Core.Generators.csproj         Skua.Core.Generators/
COPY Skua.Core.Interfaces/Skua.Core.Interfaces.csproj         Skua.Core.Interfaces/
COPY Skua.Core.Models/Skua.Core.Models.csproj                 Skua.Core.Models/
COPY Skua.Core.Utils/Skua.Core.Utils.csproj                   Skua.Core.Utils/
COPY Skua.WPF/Skua.WPF.csproj                                 Skua.WPF/
COPY Skua.App.WPF/Skua.App.WPF.csproj                         Skua.App.WPF/
COPY Skua.App.WPF.Follower/Skua.App.WPF.Follower.csproj       Skua.App.WPF.Follower/
COPY Skua.App.WPF.Lite/Skua.App.WPF.Lite.csproj               Skua.App.WPF.Lite/
COPY Skua.App.WPF.Sync/Skua.App.WPF.Sync.csproj               Skua.App.WPF.Sync/
COPY Skua.Manager/Skua.Manager.csproj                         Skua.Manager/
COPY Skua.Plugin.DailyTracker/Skua.Plugin.DailyTracker.csproj Skua.Plugin.DailyTracker/

# The Flash COM interop assemblies are <Reference HintPath="..."> targets.
COPY Skua.App.WPF/Assemblies/ Skua.App.WPF/Assemblies/

RUN dotnet restore Skua.sln

# ------------------------------------------------------------------ build ---
FROM restore AS build

COPY . .

# The release layout is produced by the PostBuild targets inside the .csproj
# files, which copy into C:\src\Build\AnyCPU. skua.swf is the committed
# pre-built artifact, so no Flex SDK is needed here — same as
# .github/workflows/release.yml.
RUN dotnet build Skua.sln -c Release -p:WarningLevel=0 --nologo

# ---------------------------------------------------------------- package ---
# Optional Velopack packaging, mirroring Build-VibeSkua.ps1 and release.yml.
# Version defaults to <Version> in Directory.Build.props.
FROM build AS package

ARG VERSION=""
ENV PATH="C:\Users\ContainerAdministrator\.dotnet\tools;${PATH}"

RUN $v = $env:VERSION; `
    if ([string]::IsNullOrWhiteSpace($v)) { `
      $props = Get-Content -Raw Directory.Build.props; `
      if ($props -notmatch '<Version>([^<]+)</Version>') { throw 'Could not read <Version> from Directory.Build.props' }; `
      $v = $Matches[1].Trim(); `
    }; `
    Write-Host "Packaging VibeSkua v$v"; `
    dotnet tool install -g vpk; `
    vpk pack -u VibeSkua -v $v -p Build\AnyCPU -e Skua.exe -o Releases; `
    if ($LASTEXITCODE -ne 0) { throw 'vpk pack failed' }; `
    Get-ChildItem Releases -Filter '*Portable.zip' -ErrorAction SilentlyContinue | Remove-Item -Force

# ----------------------------------------------------------------- export ---
# Default target: a thin image carrying only the compiled release layout.
# Run it with a host directory bind-mounted at C:\out.
FROM ${EXPORT_IMAGE} AS export
SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference='Stop';"]

WORKDIR C:/artifacts
COPY --from=build C:/src/Build/ ./Build/

# robocopy merges cleanly into the bind-mounted directory; exit codes < 8 are
# success by its own convention, so translate them for Docker.
CMD robocopy C:\artifacts C:\out /E /NFL /NDL /NJH /NJS /NP; `
    if ($LASTEXITCODE -ge 8) { exit $LASTEXITCODE }; `
    Write-Host 'Copied build artifacts to C:\out'; `
    exit 0

# --------------------------------------------------------- export-package ---
# Same, plus the Velopack Releases/ output:
#   docker build -f docker/Dockerfile.windows --target export-package -t vibeskua:release .
FROM ${EXPORT_IMAGE} AS export-package
SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference='Stop';"]

WORKDIR C:/artifacts
COPY --from=package C:/src/Build/    ./Build/
COPY --from=package C:/src/Releases/ ./Releases/

CMD robocopy C:\artifacts C:\out /E /NFL /NDL /NJH /NJS /NP; `
    if ($LASTEXITCODE -ge 8) { exit $LASTEXITCODE }; `
    Write-Host 'Copied build artifacts to C:\out'; `
    exit 0
