# VibeSkua Web — AQW on Ruffle, in a browser-accessible container.
#
# Same shape as linuxserver/chrome: a LinuxServer KasmVNC base image running a
# desktop app, reachable over HTTP. Browse to :3000 and the game is there.
#
#   docker compose up -d vibeskua-web
#   open http://<host>:3000
#
# WHAT THIS IS NOT: it is not the bot. It runs the AQW client on Ruffle with
# the Skua ExternalInterface bridge live, which is the foundation VibeSkua's
# automation would sit on — but Skua.Core still has no IFlashUtil pointing at
# it. See web/README.md.
#
# UNTESTED. No Docker on the machine where this was written; the image has
# never been built. The pieces it wraps (Ruffle + skua.swf + the live AQW
# client) are verified, in CI, on Linux — the packaging around them is not.

ARG BASE_IMAGE=ghcr.io/linuxserver/baseimage-kasmvnc:debianbookworm
ARG NODE_VERSION=22.11.0

FROM ${BASE_IMAGE}

ARG NODE_VERSION

# Node 22 for Electron, installed to /opt/node and deliberately kept OFF the
# global PATH.
#
# The KasmVNC base ships its own Node 18 for its web/audio client under
# /kclient, whose native pulseaudio2 module is built for
# NODE_MODULE_VERSION 108. Installing Node 22 into /usr/local shadows that
# and /kclient dies at startup with ERR_DLOPEN_FAILED ("compiled against a
# different Node.js version ... requires NODE_MODULE_VERSION 127").
#
# .tar.gz, not .tar.xz: the base image has no xz binary, so `tar -xJ` dies
# with "xz: Cannot exec: No such file or directory".
ENV NODE_HOME=/opt/node
RUN mkdir -p "$NODE_HOME" \
 && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" \
      | tar -xz -C "$NODE_HOME" --strip-components=1 \
 && "$NODE_HOME/bin/node" --version \
 && "$NODE_HOME/bin/npm" --version \
 && echo "base image node stays at: $(command -v node || echo none)"

# Electron's runtime libraries, plus unzip which setup.js shells out to when
# unpacking the Ruffle web build.
RUN apt-get update && apt-get install -y --no-install-recommends \
      unzip \
      libasound2 \
      libatspi2.0-0 \
      libgbm1 \
      libgtk-3-0 \
      libnotify4 \
      libnss3 \
      libsecret-1-0 \
      libxss1 \
      libxtst6 \
      xdg-utils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first so npm install caches independently of app source.
COPY web/package.json ./
RUN "$NODE_HOME/bin/npm" install --no-audit --no-fund

COPY web/ ./

# setup.js normally copies this out of the repo tree, which is not at that path
# inside the build context; stage it directly and let setup.js keep it.
COPY Skua.AS3/skua/bin/skua.swf ./public/skua.swf

# Optional: a zip of a custom Ruffle self-hosted build instead of the pinned
# official release -- e.g. one carrying the Loader.unloadAndStop / close
# fixes. Empty means the official release.
ARG RUFFLE_WEB_URL=""
RUN RUFFLE_WEB_URL="$RUFFLE_WEB_URL" "$NODE_HOME/bin/node" setup.js

# LinuxServer's init runs this to launch the session's application.
COPY docker/kasm-root/ /
RUN chmod +x /defaults/autostart

ENV TITLE="VibeSkua Web" \
    PORT=8770 \
    SOCKET_PROXY_PORT=8181

EXPOSE 3000 3001
