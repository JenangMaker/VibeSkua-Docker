# VibeSkua Web — VibeSkua (Skua + AQW on Ruffle) in a browser-accessible
# container. How to run it: DOCKER.md.
#
# Same shape as linuxserver/chrome: a LinuxServer KasmVNC base image running a
# desktop app, reachable over HTTP. Browse to :3000 and VibeSkua is there:
# Skua's UI (Skua.App.Avalonia) with the game embedded, one tab per account.
#
#   docker compose -f docker-compose.minimal.yml up -d
#   open http://<host>:3000

ARG BASE_IMAGE=ghcr.io/linuxserver/baseimage-kasmvnc:debianbookworm
ARG NODE_VERSION=24.21.0

# Skua: Skua.App.Avalonia, the VibeSkua client UI ported to Avalonia over
# Skua.Core, driving the game in the page (SKUA_HOST=1; SKUA_UI=0 runs it with
# no windows). Self-contained, so the runtime image needs no .NET. Not
# single-file: the script compiler (Roslyn) resolves references from assembly
# paths on disk. See Skua.App.Avalonia/README.md.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS skua
WORKDIR /src
COPY Directory.Build.props ./
COPY Shared/ Shared/
COPY Skua.Core/ Skua.Core/
COPY Skua.Core.Generators/ Skua.Core.Generators/
COPY Skua.Core.Interfaces/ Skua.Core.Interfaces/
COPY Skua.Core.Models/ Skua.Core.Models/
COPY Skua.Core.Utils/ Skua.Core.Utils/
COPY Skua.Ruffle/ Skua.Ruffle/
COPY Skua.Host.WinForms/ Skua.Host.WinForms/
COPY Skua.Linux/ Skua.Linux/
COPY Skua.App.Avalonia/ Skua.App.Avalonia/
RUN dotnet publish Skua.App.Avalonia/Skua.App.Avalonia.csproj -c Release -r linux-x64 \
      --self-contained true -p:PublishSingleFile=false -o /out \
 && test -x /out/Skua.App.Avalonia

FROM ${BASE_IMAGE}

ARG NODE_VERSION

# Node 24 for installing Electron and running setup.js (the app itself runs
# on the Node inside Electron), installed to /opt/node and deliberately kept
# OFF the global PATH.
#
# The KasmVNC base ships its own Node 18 for its web/audio client under
# /kclient, whose native pulseaudio2 module is built for
# NODE_MODULE_VERSION 108. Installing Node 22 into /usr/local shadows that
# and /kclient dies at startup with ERR_DLOPEN_FAILED ("compiled against a
# different Node.js version ... requires NODE_MODULE_VERSION 127").
#
# .tar.gz, not .tar.xz: the base image has no xz binary, so `tar -xJ` dies
# with "xz: Cannot exec: No such file or directory".
ENV NODE_HOME=/opt/node
RUN mkdir -p "$NODE_HOME" \
 && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" \
      | tar -xz -C "$NODE_HOME" --strip-components=1 \
 && "$NODE_HOME/bin/node" --version \
 && "$NODE_HOME/bin/npm" --version \
 && echo "base image node stays at: $(command -v node || echo none)"

# Electron's runtime libraries, plus unzip which setup.js shells out to when
# unpacking the Ruffle web build.
RUN apt-get update && apt-get install -y --no-install-recommends \
      unzip \
      libasound2 \
      libatspi2.0-0 \
      libgbm1 \
      libgtk-3-0 \
      libnotify4 \
      libnss3 \
      libsecret-1-0 \
      libxss1 \
      libxtst6 \
      xdg-utils \
      libice6 \
      libsm6 \
      libfontconfig1 \
      fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first so npm install caches independently of app source.
COPY web/package.json ./
# Electron's npm package no longer downloads its binary on install (it does so
# on first require), and launch.sh runs the binary directly: fetch it here.
# npm starts through `#!/usr/bin/env node`, so for this step only our Node goes
# first on PATH; otherwise npm runs on the base image's Node 18 (Electron
# needs 22.12+).
RUN PATH="$NODE_HOME/bin:$PATH" npm install --no-audit --no-fund \
 && "$NODE_HOME/bin/node" node_modules/electron/install.js \
 && test -x node_modules/electron/dist/electron

COPY web/ ./

# setup.js normally copies this out of the repo tree, which is not at that path
# inside the build context; stage it directly and let setup.js keep it.
COPY Skua.AS3/skua/bin/skua.swf ./public/skua.swf

# Optional: a zip of a custom Ruffle self-hosted build instead of the pinned
# official release -- e.g. one carrying the Loader.unloadAndStop / close
# fixes. Empty means the official release.
#
# On a private Gitea, anonymous downloads get 404. Supply "user:token" as a
# BuildKit secret -- never a build arg, which would persist in the image
# history:
#   docker build --secret id=ruffle_web_auth,env=RUFFLE_WEB_AUTH ...
ARG RUFFLE_WEB_URL=""
RUN --mount=type=secret,id=ruffle_web_auth \
    RUFFLE_WEB_AUTH="$(cat /run/secrets/ruffle_web_auth 2>/dev/null || true)" \
    RUFFLE_WEB_URL="$RUFFLE_WEB_URL" \
    "$NODE_HOME/bin/node" setup.js

# LinuxServer's init runs /defaults/autostart (via openbox, with /bin/sh) to
# launch the session's application; it hands off to /app/launch.sh. The
# custom-cont-init.d script re-copies the autostart into /config each start.
COPY --from=skua /out/ /opt/skua/

COPY docker/kasm-root/ /
RUN chmod +x /defaults/autostart /app/launch.sh \
 && chmod 755 /custom-cont-init.d/10-vibeskua-autostart \
 && chown root:root /custom-cont-init.d/10-vibeskua-autostart

ENV TITLE="VibeSkua Web" \
    PORT=8770 \
    SOCKET_PROXY_PORT=8181 \
    SKUA_HOST=1

EXPOSE 3000 3001
