<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Skua.Core on Linux against the vibeskua-web Ruffle page: the runtime shared
    by Skua.Host (no UI) and Skua.App.Avalonia (Skua's UI). See SkuaRuntime.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Core\Skua.Core.csproj" />
    <ProjectReference Include="..\Skua.Ruffle\Skua.Ruffle.csproj" />
    <!-- System.Windows.Forms stand-in; ships with the runtime so scripts compile. -->
    <ProjectReference Include="..\Skua.Host.WinForms\Skua.Host.WinForms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- POST /debug/trace: CPU-samples this process (TraceApi). -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.745401" />
    <!-- Only its managed parser (the trace summary), not the native Windows symbol readers its build props copy (~7 MB). -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" ExcludeAssets="build;buildTransitive" PrivateAssets="build;buildTransitive;analyzers;contentfiles" />
  </ItemGroup>

</Project>
