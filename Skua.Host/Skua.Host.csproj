<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Skua without a UI, for Linux: Skua.Linux's runtime driving skua.swf in the
    vibeskua-web container's Ruffle page. Scripts are loaded and started
    through a small local HTTP API. Skua.App.Avalonia is the same with Skua's
    windows.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Linux\Skua.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- No spinning before thread pool threads sleep: see Skua.App.Avalonia.csproj. -->
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.UnfairSemaphoreSpinLimit" Value="0" />
  </ItemGroup>

</Project>
